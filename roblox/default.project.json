{
  "name": "JuegoFuerza",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Config": { "$path": "src/ReplicatedStorage/Config.lua" },
      "AnimData": { "$path": "src/ReplicatedStorage/AnimData.lua" },
      "AnimPlayer": { "$path": "src/ReplicatedStorage/AnimPlayer.lua" },
      "Remotes": {
        "$className": "Folder",
        "Notificar": { "$className": "RemoteEvent" },
        "Efecto": { "$className": "RemoteEvent" },
        "Anim": { "$className": "RemoteEvent" },
        "Empuje": { "$className": "RemoteEvent" },
        "UsarHabilidad": { "$className": "RemoteEvent" },
        "ClubInvitar": { "$className": "RemoteEvent" },
        "ClubResponder": { "$className": "RemoteEvent" },
        "ClubSalir": { "$className": "RemoteEvent" },
        "ClubInvitacion": { "$className": "RemoteEvent" },
        "DueloSolicitar": { "$className": "RemoteEvent" },
        "DueloResponder": { "$className": "RemoteEvent" },
        "DueloInvitacion": { "$className": "RemoteEvent" },
        "DueloEstado": { "$className": "RemoteEvent" },
        "DueloAccion": { "$className": "RemoteEvent" },
        "ComandoDebug": { "$className": "RemoteEvent" },
        "ObtenerEstado": { "$className": "RemoteFunction" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": { "$path": "src/ServerScriptService/Main" }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "Espadas": { "$path": "assets/Espadas" },
      "Animaciones": { "$path": "assets/Animaciones" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/StarterPlayerScripts/Client" }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "Ambient": [0.27, 0.27, 0.3],
        "OutdoorAmbient": [0.5, 0.5, 0.55],
        "GlobalShadows": true
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "Suelo": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [600, 4, 600],
          "CFrame": { "CFrame": { "position": [0, -2, 0], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
          "Color": [0.36, 0.55, 0.3],
          "Material": "Grass",
          "TopSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "CFrame": { "CFrame": { "position": [0, 0.5, 40], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
          "Color": [0.9, 0.75, 0.25],
          "Material": "Neon",
          "Duration": 0
        }
      },
      "Entrenamiento": { "$path": "assets/Workspace/Entrenamiento.model.json" },
      "Arena": { "$path": "assets/Workspace/Arena.model.json" }
    }
  }
}
