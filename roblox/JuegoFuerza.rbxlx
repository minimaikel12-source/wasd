      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">AnimPlayer</string>
        <string name="Source"><![CDATA[--[[
	AnimPlayer — reproduce una animación por nombre.
	 • Si Config.Animaciones[nombre] tiene ID → AnimationTrack normal (se replica sola).
	 • Si no → respaldo procedural: interpola los mismos keyframes (AnimData) sobre
	   Motor6D.Transform en RunService.Stepped (después del Animator), así que
	   funciona YA sin publicar nada. Solo rig R15.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local AnimData = require(ReplicatedStorage:WaitForChild("AnimData"))

local AnimPlayer = {}

local FADE_IN, FADE_OUT = 0.1, 0.18
local activos = {} -- [character] = { reproduccion, ... }
local cacheTracks = setmetatable({}, { __mode = "k" }) -- [animator] = { [nombre] = track }
local conexion

local function cframeDe(k)
	return CFrame.new(k[5], k[6], k[7]) * CFrame.Angles(math.rad(k[2]), math.rad(k[3]), math.rad(k[4]))
end

local function aliviar(alpha, estilo, direccion)
	if estilo == "Constant" then
		return 0
	end
	local ok, valor = pcall(function()
		return TweenService:GetValue(alpha, Enum.EasingStyle[estilo], Enum.EasingDirection[direccion])
	end)
	return ok and valor or alpha
end

local function evaluarPista(pista, t)
	local n = #pista
	if t <= pista[1][1] then
		return cframeDe(pista[1])
	end
	for i = 1, n - 1 do
		local a, b = pista[i], pista[i + 1]
		if t < b[1] then
			local alpha = (t - a[1]) / math.max(b[1] - a[1], 1e-4)
			return cframeDe(a):Lerp(cframeDe(b), aliviar(alpha, a[8], a[9]))
		end
	end
	return cframeDe(pista[n])
end

local function paso()
	local ahora = os.clock()
	for personaje, lista in pairs(activos) do
		if not personaje.Parent then
			activos[personaje] = nil
			continue
		end
		for i = #lista, 1, -1 do
			local r = lista[i]
			local datos = r.Datos
			local t = (ahora - r.Inicio) * r.Velocidad
			local peso = math.clamp((ahora - r.Inicio) / FADE_IN, 0, 1)
			if r.Parando then
				peso = math.min(peso, 1 - math.clamp((ahora - r.Parando) / FADE_OUT, 0, 1))
				t = r.TParada
			elseif t >= datos.Duracion then
				if datos.Bucle then
					t = t % datos.Duracion
				elseif r.Mantener then
					t = datos.Duracion
				else
					r.Parando, r.TParada = ahora, datos.Duracion
					t = datos.Duracion
				end
			end
			if r.Parando and ahora - r.Parando >= FADE_OUT then
				table.remove(lista, i)
				continue
			end
			r.TActual = t
			for motorNombre, pista in pairs(datos.Pistas) do
				local motor = r.Motores[motorNombre]
				if motor == nil then
					local parte = personaje:FindFirstChild(pista.Parte)
					motor = parte and parte:FindFirstChild(motorNombre) or false
					r.Motores[motorNombre] = motor
				end
				if motor and motor.Parent then
					local objetivo = evaluarPista(pista, t)
					motor.Transform = peso >= 1 and objetivo or motor.Transform:Lerp(objetivo, peso)
				end
			end
		end
		if #lista == 0 then
			activos[personaje] = nil
		end
	end
	if next(activos) == nil and conexion then
		conexion:Disconnect()
		conexion = nil
	end
end

function AnimPlayer.TieneID(nombre)
	local id = Config.Animaciones[nombre]
	return id ~= nil and id ~= ""
end

local function reproducirTrack(personaje, nombre, opciones)
	local humanoid = personaje:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	cacheTracks[animator] = cacheTracks[animator] or {}
	local track = cacheTracks[animator][nombre]
	if not track then
		local anim = Instance.new("Animation")
		anim.AnimationId = Config.Animaciones[nombre]
		local ok, resultado = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok then
			warn("[AnimPlayer] No se pudo cargar", nombre, resultado)
			return nil
		end
		track = resultado
		track.Priority = Enum.AnimationPriority.Action
		cacheTracks[animator][nombre] = track
	end
	track:Play(FADE_IN, 1, opciones.Velocidad or 1)
	if opciones.Mantener then
		task.delay(math.max(track.Length - 0.05, 0.1) / (opciones.Velocidad or 1), function()
			if track.IsPlaying then
				track:AdjustSpeed(0)
			end
		end)
	end
	return {
		Detener = function()
			track:Stop(FADE_OUT)
		end,
	}
end

-- Reproduce `nombre` en `personaje`. opciones = { Velocidad, Mantener, SoloProcedural }
function AnimPlayer.Reproducir(personaje, nombre, opciones)
	opciones = opciones or {}
	if not personaje then
		return nil
	end
	if not opciones.SoloProcedural and AnimPlayer.TieneID(nombre) then
		local c = reproducirTrack(personaje, nombre, opciones)
		if c then
			return c
		end
	end
	local datos = AnimData[nombre]
	local humanoid = personaje:FindFirstChildOfClass("Humanoid")
	if not datos or not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	local r = {
		Datos = datos,
		Nombre = nombre,
		Inicio = os.clock(),
		Velocidad = opciones.Velocidad or 1,
		Mantener = opciones.Mantener,
		Motores = {},
	}
	activos[personaje] = activos[personaje] or {}
	table.insert(activos[personaje], r)
	if not conexion then
		conexion = RunService.Stepped:Connect(paso)
	end
	return {
		Detener = function()
			if not r.Parando then
				r.Parando, r.TParada = os.clock(), r.TActual or 0
			end
		end,
	}
end

function AnimPlayer.DetenerTodo(personaje)
	local lista = activos[personaje]
	if lista then
		for _, r in ipairs(lista) do
			if not r.Parando then
				r.Parando, r.TParada = os.clock(), r.TActual or 0
			end
		end
	end
	local humanoid = personaje and personaje:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator and cacheTracks[animator] then
		for _, track in pairs(cacheTracks[animator]) do
			track:Stop(FADE_OUT)
		end
	end
end

return AnimPlayer
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Config</string>
        <string name="Source"><![CDATA[--[[
	CONFIG — todos los números ajustables del juego.
	Lo leen el servidor (ServerScriptService/Main) y el cliente (StarterPlayerScripts/Client).
	El servidor SIEMPRE valida con estos valores: cambiar algo en el cliente no da ventaja.
]]

local Config = {}

---------------------------------------------------------------------------
-- DEPURACIÓN / PRUEBAS
---------------------------------------------------------------------------
Config.Debug = {
	-- Comandos de chat SOLO en Studio: "/fuerza 5000", "/dias 7", "/duelo"
	ComandosEnStudio = true,
}

---------------------------------------------------------------------------
-- GUARDADO
---------------------------------------------------------------------------
Config.Guardado = {
	NombreDataStore = "FuerzaClubs_v1",
	IntervaloAutoguardado = 90, -- segundos
	Reintentos = 3,
}

---------------------------------------------------------------------------
-- ENTRENAMIENTO (Workspace/Entrenamiento). La clave = atributo "Clave" del modelo.
---------------------------------------------------------------------------
Config.Entrenamiento = {
	Cooldown = 1.1, -- segundos entre repeticiones (anti-spam, validado en servidor)
	DistanciaMaxima = 14, -- studs desde el equipo
	Equipos = {
		PesasLigeras = { Fuerza = 1, Requisito = 0, Anim = "Entrenar_Pesas" },
		SacoBoxeo = { Fuerza = 2, Requisito = 0, Anim = "Entrenar_Punetazos" },
		PesasPesadas = { Fuerza = 6, Requisito = 150, Anim = "Entrenar_Pesas" },
		SacoAcero = { Fuerza = 20, Requisito = 800, Anim = "Entrenar_Punetazos" },
		RocaTitan = { Fuerza = 75, Requisito = 4000, Anim = "Entrenar_Pesas" },
		YunqueColosal = { Fuerza = 250, Requisito = 15000, Anim = "Entrenar_Punetazos" },
	},
	-- Muñecos de práctica (habilidades)
	Munecos = {
		FuerzaPorKO = 15,
		Reaparicion = 5, -- segundos
	},
}

---------------------------------------------------------------------------
-- HABILIDADES (en orden de desbloqueo)
-- Efecto: tipo de efecto/hitbox que ejecuta el servidor y dibuja el cliente.
---------------------------------------------------------------------------
Config.Habilidades = {
	{
		Nombre = "Puño Potente", Id = "PunoPotente", Tecla = "Q",
		Fuerza = 25, Cooldown = 2, Dano = 60, Alcance = 9, Retraso = 0.33,
		Empuje = 40, Efecto = "Golpe", Anim = "Hab_PunoPotente", Temblor = 0.25,
	},
	{
		Nombre = "Patada Giratoria", Id = "PatadaGiratoria", Tecla = "E",
		Fuerza = 200, Cooldown = 4, Dano = 110, Alcance = 11, Retraso = 0.4,
		Empuje = 60, Efecto = "Giro", Anim = "Hab_PatadaGiratoria", Temblor = 0.35,
	},
	{
		Nombre = "Embestida", Id = "Embestida", Tecla = "R",
		Fuerza = 900, Cooldown = 6, Dano = 180, Alcance = 6, Retraso = 0.3,
		Distancia = 45, DuracionDash = 0.35,
		Empuje = 90, Efecto = "Embestida", Anim = "Hab_Embestida", Temblor = 0.5,
	},
	{
		Nombre = "Onda Expansiva", Id = "OndaExpansiva", Tecla = "F",
		Fuerza = 3000, Cooldown = 9, Dano = 300, Alcance = 30, Retraso = 0.53,
		Empuje = 120, Efecto = "Onda", Anim = "Hab_OndaExpansiva", Temblor = 0.9,
	},
	{
		Nombre = "Salto Sísmico", Id = "SaltoSismico", Tecla = "G",
		Fuerza = 9000, Cooldown = 12, Dano = 500, Alcance = 38, Retraso = 0.95,
		AlturaSalto = 60, Empuje = 160, Efecto = "Sismo", Anim = "Hab_SaltoSismico", Temblor = 1.4,
	},
	{
		Nombre = "Furia del Titán", Id = "FuriaTitan", Tecla = "T",
		Fuerza = 25000, Cooldown = 20, Dano = 900, Alcance = 60, Retraso = 1.35,
		Empuje = 220, Efecto = "Titan", Anim = "Hab_FuriaTitan", Temblor = 2.2,
	},
}
Config.HabilidadesEnDuelo = false -- el duelo es solo de espadas

---------------------------------------------------------------------------
-- CLUBS Y MENTORÍA
---------------------------------------------------------------------------
Config.Mentoria = {
	MaxMiembros = 2,
	TiempoInvitacion = 30, -- segundos para aceptar
	BonusAprendiz = 2, -- multiplicador de fuerza al entrenar cerca del mentor
	DistanciaBonus = 40, -- studs
	DiferenciaParaAviso = 0.10, -- el aviso "Ayuda a X" sale si el aprendiz tiene un 10% menos de fuerza o más
	SegundosPorDia = 86400, -- pon 10 para probar rápido "días" en Studio
}

---------------------------------------------------------------------------
-- DUELO
---------------------------------------------------------------------------
Config.Duelo = {
	DiasMinimos = 7, -- días en el club antes de poder hacer el duelo
	MargenFuerza = 0.10, -- "misma fuerza": diferencia relativa <= 10 %
	FuerzaMinima = 100, -- los dos necesitan al menos esto
	TiempoInvitacion = 45,
	CooldownInvitacion = 120, -- segundos entre invitaciones automáticas
	CuentaAtras = 3,
	DuracionMaxima = 240, -- si nadie gana, gana quien tenga más vida

	Vida = 1000,
	Combo = { 70, 70, 120 }, -- daño de cada golpe del combo (clic)
	ComboVentana = 0.9, -- segundos para encadenar el siguiente golpe
	ComboCooldown = 0.38, -- entre golpes
	ComboRetraso = 0.18, -- momento del impacto
	Pesado = { Dano = 220, Cooldown = 1.6, Retraso = 0.6, RompeBloqueo = true },
	AlcanceEspada = 9, -- profundidad de la hitbox delante del jugador
	AnchoHitbox = 8,
	BloqueoReduccion = 0.8, -- 80 % menos daño bloqueando de frente
	BloqueoVelocidad = 6, -- WalkSpeed mientras bloquea
	Esquiva = { Cooldown = 1.2, Invulnerable = 0.35, Velocidad = 70 },
	Aturdimiento = 0.5, -- al romper un bloqueo

	RecompensaGanador = 500,
	RecompensaPerdedor = 150,
	RetornoTras = 7, -- segundos de pantalla final antes de volver

	-- Agarre de la espada (Tool.Grip). Si ves la hoja mal orientada, cambia GripRot.
	GripPos = { 0, -0.2, 0 },
	GripRot = { 0, 0, 0 }, -- grados
}

Config.Teclas = {
	DueloPesado = { "E", "MouseButton2" },
	DueloBloqueo = "F", -- mantener
	DueloEsquiva = "Q",
}

---------------------------------------------------------------------------
-- ARENA / AMBIENTE (solo se aplica en el cliente de los duelistas)
---------------------------------------------------------------------------
Config.Ambiente = {
	ClockTime = 0.5,
	Brightness = 0.6,
	Ambient = { 25, 28, 38 },
	OutdoorAmbient = { 35, 38, 50 },
	FogColor = { 30, 33, 42 },
	FogStart = 10,
	FogEnd = 260,
	DensidadAtmosfera = 0.55,
	Relampago = { Min = 4, Max = 11 }, -- segundos entre relámpagos
	LluviaRate = 900,
}

---------------------------------------------------------------------------
-- SONIDOS (rellena con IDs de la Creator Store: Toolbox → Audio).
-- Los "rbxasset://" vienen con Roblox y funcionan siempre.
---------------------------------------------------------------------------
Config.Sonidos = {
	MusicaDuelo = "", -- p.ej. "rbxassetid://123456" (música épica)
	Lluvia = "", -- bucle de lluvia
	Trueno = "", -- si está vacío se usa un respaldo grave
	Desbloqueo = "rbxasset://sounds/electronicpingshort.wav",
	Impacto = "rbxasset://sounds/collide.wav",
	Explosion = "rbxasset://sounds/Rocket shot.wav",
	Tajo = "rbxasset://sounds/swordslash.wav",
	Estocada = "rbxasset://sounds/swordlunge.wav",
	Desenvainar = "rbxasset://sounds/unsheath.wav",
}

---------------------------------------------------------------------------
-- ANIMACIONES — pega aquí los IDs tras publicar cada KeyframeSequence de
-- ServerStorage/Animaciones (ver README). Formato: "rbxassetid://123456789".
-- Si está vacío se usa el respaldo procedural (ReplicatedStorage/AnimData).
---------------------------------------------------------------------------
Config.Animaciones = {
	Entrenar_Pesas = "",
	Entrenar_Punetazos = "",
	Hab_PunoPotente = "",
	Hab_PatadaGiratoria = "",
	Hab_Embestida = "",
	Hab_OndaExpansiva = "",
	Hab_SaltoSismico = "",
	Hab_FuriaTitan = "",
	Espada_Desenvainar = "",
	Espada_Combo1 = "",
	Espada_Combo2 = "",
	Espada_Combo3 = "",
	Espada_Pesado = "",
	Espada_Bloqueo = "",
	Espada_Esquiva = "",
	Espada_Impacto = "",
	Victoria = "",
	Derrota = "",
}

-- Utilidades compartidas -------------------------------------------------
function Config.ObtenerHabilidad(id)
	for _, h in ipairs(Config.Habilidades) do
		if h.Id == id then
			return h
		end
	end
	return nil
end

-- ¿Tienen "la misma fuerza"? (diferencia relativa dentro del margen)
function Config.MismaFuerza(a, b)
	local mayor = math.max(a, b)
	if mayor <= 0 then
		return false
	end
	return math.abs(a - b) / mayor <= Config.Duelo.MargenFuerza
end

function Config.Color(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

return Config
]]></string>
      </Properties>
