                </Properties>
                <Item class="Pose" referent="37">
                  <Properties>
                    <string name="Name">LeftLowerLeg</string>
                    <CoordinateFrame name="CFrame">
                      <X>0</X>
                      <Y>0</Y>
                      <Z>0</Z>
                      <R00>1</R00>
                      <R01>0</R01>
                      <R02>0</R02>
                      <R10>0</R10>
                      <R11>1</R11>
                      <R12>0</R12>
                      <R20>0</R20>
                      <R21>0</R21>
                      <R22>1</R22>
                    </CoordinateFrame>
                    <token name="EasingDirection">1</token>
                    <token name="EasingStyle">3</token>
                    <float name="Weight">1</float>
                  </Properties>
                </Item>
              </Item>
              <Item class="Pose" referent="38">
                <Properties>
                  <string name="Name">UpperTorso</string>
                  <CoordinateFrame name="CFrame">
                    <X>0</X>
                    <Y>0</Y>
                    <Z>0</Z>
