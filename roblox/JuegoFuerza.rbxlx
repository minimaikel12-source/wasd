  <Item class="StarterPlayer" referent="1314">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="1315">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="1316">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client — punto de entrada del cliente.
	Módulos hijos: UI, Efectos, Ambiente, Mentoria, Duelo.
	El cliente solo PIDE acciones; el servidor valida y decide.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local AnimPlayer = require(ReplicatedStorage:WaitForChild("AnimPlayer"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local UI = require(script:WaitForChild("UI"))
local Efectos = require(script:WaitForChild("Efectos"))
require(script:WaitForChild("Ambiente"))
local Mentoria = require(script:WaitForChild("Mentoria"))
local Duelo = require(script:WaitForChild("Duelo"))

local jugador = Players.LocalPlayer
local desbloqueadas = {}

---------------------------------------------------------------- estado / stats
local function actualizarFuerza()
	UI.ActualizarFuerza(jugador:GetAttribute("Fuerza") or 0)
end

local function actualizarHabilidades()
	local ok, lista = pcall(HttpService.JSONDecode, HttpService, jugador:GetAttribute("Habilidades") or "[]")
	desbloqueadas = {}
	if ok and type(lista) == "table" then
		for _, id in ipairs(lista) do
			desbloqueadas[id] = true
		end
	end
	UI.ActualizarHabilidades(desbloqueadas)
end

jugador:GetAttributeChangedSignal("Fuerza"):Connect(actualizarFuerza)
jugador:GetAttributeChangedSignal("Habilidades"):Connect(actualizarHabilidades)
actualizarFuerza()
actualizarHabilidades()

---------------------------------------------------------------- acciones de UI
UI.Acciones.Invitar = function(userId)
	Remotes.ClubInvitar:FireServer(userId)
end
UI.Acciones.Salir = function()
	Remotes.ClubSalir:FireServer()
end
UI.Acciones.Retar = function()
	Remotes.DueloSolicitar:FireServer()
end
UI.Acciones.PedirEstado = function()
	local ok, estado = pcall(Remotes.ObtenerEstado.InvokeServer, Remotes.ObtenerEstado)
	return ok and estado or nil
end

---------------------------------------------------------------- notificaciones
Remotes.Notificar.OnClientEvent:Connect(function(d)
	if d.Tipo == "Ganancia" then
		UI.Ganancia(d.Cantidad, d.Bonus, d.Texto)
	elseif d.Tipo == "Mensaje" then
		UI.Mensaje(d.Texto, d.Color)
	elseif d.Tipo == "Desbloqueo" then
		UI.Desbloqueo(d.Nombre, d.Tecla)
		Efectos.Temblor(0.8, 1)
	elseif d.Tipo == "Club" then
		UI.Mensaje(d.Texto, Color3.fromRGB(140, 190, 255))
		UI.RefrescarClub()
	end
end)

Remotes.ClubInvitacion.OnClientEvent:Connect(function(d)
	UI.Pregunta("👥 INVITACIÓN A CLUB", ("%s (Fuerza %d) te invita a su club."):format(d.DeNombre, d.DeFuerza), d.Tiempo,
		Color3.fromRGB(110, 170, 255), function(si)
			Remotes.ClubResponder:FireServer(si)
		end)
end)

Remotes.Efecto.OnClientEvent:Connect(Efectos.Procesar)
Remotes.Empuje.OnClientEvent:Connect(function(vel)
	if typeof(vel) == "Vector3" then
		Efectos.Empuje(vel)
	end
end)

---------------------------------------------------------------- animaciones remotas
local manejadores = setmetatable({}, { __mode = "k" }) -- [personaje] = { [nombre] = controlador }

Remotes.Anim.OnClientEvent:Connect(function(personaje, nombre, opciones)
	if not personaje then
		return
	end
	opciones = opciones or {}
	manejadores[personaje] = manejadores[personaje] or {}
	if opciones.Detener then
		if nombre then
			local c = manejadores[personaje][nombre]
			if c then
				c.Detener()
				manejadores[personaje][nombre] = nil
			end
		else
			AnimPlayer.DetenerTodo(personaje)
			manejadores[personaje] = {}
		end
		return
	end
	-- Con ID publicado, la animación de OTRO jugador ya nos llega replicada desde su Animator.
	if personaje ~= jugador.Character and AnimPlayer.TieneID(nombre) then
		return
	end
	manejadores[personaje][nombre] = AnimPlayer.Reproducir(personaje, nombre, opciones)
end)

---------------------------------------------------------------- habilidades
local cooldownLocal = {}

local function usarHabilidad(h)
	if Duelo.EnDuelo() and not Config.HabilidadesEnDuelo then
		return
	end
	if not desbloqueadas[h.Id] then
		UI.Mensaje(("%s se desbloquea con %d de Fuerza"):format(h.Nombre, h.Fuerza), Color3.fromRGB(255, 180, 90))
		return
	end
	local ahora = os.clock()
	if (cooldownLocal[h.Id] or 0) > ahora then
		return
	end
	local personaje = jugador.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	local humanoid = personaje and personaje:FindFirstChildOfClass("Humanoid")
	if not raiz or not humanoid or humanoid.Health <= 0 then
		return
	end
	cooldownLocal[h.Id] = ahora + h.Cooldown
	UI.Cooldown(h.Id, h.Cooldown)
	AnimPlayer.Reproducir(personaje, h.Anim)
	Remotes.UsarHabilidad:FireServer(h.Id)

	-- Movimiento propio (el cliente es dueño de su física)
	if h.Efecto == "Embestida" then
		task.delay(h.Retraso - 0.05, function()
			local r = personaje:FindFirstChild("HumanoidRootPart")
			if r then
				Efectos.Dash(r.CFrame.LookVector, h.Distancia / h.DuracionDash, h.DuracionDash)
			end
		end)
	elseif h.Efecto == "Sismo" then
		task.delay(0.25, function()
			Efectos.Dash(raiz.CFrame.LookVector * 0.35 + Vector3.new(0, 1, 0), h.AlturaSalto, 0.3)
		end)
		task.delay(h.Retraso - 0.22, function()
			Efectos.Dash(Vector3.new(0, -1, 0), 160, 0.2)
		end)
	elseif h.Efecto == "Titan" then
		task.delay(1.0, function()
			Efectos.Dash(Vector3.new(0, 1, 0), 30, 0.25)
		end)
	end
end

local porTecla = {}
for _, h in ipairs(Config.Habilidades) do
	porTecla[h.Tecla] = h
end

-- Si hay un ProximityPrompt visible con esa tecla (p.ej. E en las pesas), manda el prompt.
local promptsVisibles = {}
local ProximityPromptService = game:GetService("ProximityPromptService")
ProximityPromptService.PromptShown:Connect(function(p)
	promptsVisibles[p] = true
end)
ProximityPromptService.PromptHidden:Connect(function(p)
	promptsVisibles[p] = nil
end)

UserInputService.InputBegan:Connect(function(entrada, procesado)
	if procesado or Duelo.EnDuelo() then
		return
	end
	for p in pairs(promptsVisibles) do
		if p.KeyboardKeyCode == entrada.KeyCode then
			return
		end
	end
	local h = porTecla[entrada.KeyCode.Name]
	if h then
		usarHabilidad(h)
	end
end)

---------------------------------------------------------------- barras de vida de los muñecos
local function barraMuneco(m)
	local cuerpo = m:WaitForChild("Cuerpo", 10)
	if not cuerpo then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 14)
	bb.StudsOffset = Vector3.new(0, 4.2, 0)
	bb.Adornee = cuerpo
	bb.MaxDistance = 80
	local fondo = Instance.new("Frame")
	fondo.Size = UDim2.fromScale(1, 1)
	fondo.BackgroundColor3 = Color3.fromRGB(40, 10, 10)
	fondo.Parent = bb
	local relleno = Instance.new("Frame")
	relleno.Size = UDim2.fromScale(1, 1)
	relleno.BackgroundColor3 = Color3.fromRGB(230, 70, 60)
	relleno.BorderSizePixel = 0
	relleno.Parent = fondo
	bb.Parent = cuerpo
	local function act()
		local v, max = m:GetAttribute("Vida") or 0, m:GetAttribute("VidaMax") or 1
		relleno.Size = UDim2.fromScale(math.clamp(v / max, 0, 1), 1)
		bb.Enabled = v > 0
	end
	m:GetAttributeChangedSignal("Vida"):Connect(act)
	act()
end
task.spawn(function()
	local zona = Workspace:WaitForChild("Entrenamiento", 30)
	local carpeta = zona and zona:WaitForChild("Munecos", 10)
	if carpeta then
		for _, m in ipairs(carpeta:GetChildren()) do
			task.spawn(barraMuneco, m)
		end
	end
end)

---------------------------------------------------------------- comandos de prueba (Studio)
if Config.Debug.ComandosEnStudio and RunService:IsStudio() then
	local TextChatService = game:GetService("TextChatService")
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		for _, nombre in ipairs({ "fuerza", "dias", "duelo" }) do
			local cmd = Instance.new("TextChatCommand")
			cmd.Name = "Debug_" .. nombre
			cmd.PrimaryAlias = "/" .. nombre
			cmd.Triggered:Connect(function(_, texto)
				Remotes.ComandoDebug:FireServer(texto)
			end)
			cmd.Parent = TextChatService
		end
	end
end

Mentoria.Iniciar()
Duelo.Iniciar()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="1317">
          <Properties>
            <string name="Name">Ambiente</string>
            <string name="Source"><![CDATA[--[[
	Ambiente — atmósfera del duelo SOLO en este cliente:
	noche cerrada, niebla densa, nubes negras, lluvia sobre la cámara, salpicaduras,
	relámpagos con destello + trueno y música épica. Al salir se restaura todo.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Efectos = require(script.Parent.Efectos)

local A = Config.Ambiente
local Ambiente = {}

local activo = false
local guardado -- propiedades originales de Lighting
local ocultos = {} -- efectos/cielos originales que desactivamos
local creados = {} -- instancias que creamos
local conexiones = {}

local PROPS = { "ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "FogColor", "FogStart", "FogEnd",
	"ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "GlobalShadows" }

local function crear(clase, props, padre)
	local i = Instance.new(clase)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = padre
	table.insert(creados, i)
	return i
end

local function sonidoLocal(id, volumen, bucle, velocidad)
	if not id or id == "" then
		return nil
	end
	return crear("Sound", { SoundId = id, Volume = volumen, Looped = bucle, PlaybackSpeed = velocidad or 1 }, Workspace.CurrentCamera)
end

local function trueno(retraso)
	task.delay(retraso, function()
		if not activo then
			return
		end
		local s
		if Config.Sonidos.Trueno ~= "" then
			s = Instance.new("Sound")
			s.SoundId = Config.Sonidos.Trueno
			s.Volume = 2
		else
			-- respaldo: explosión grave y lenta
			s = Instance.new("Sound")
			s.SoundId = Config.Sonidos.Explosion
			s.Volume = 1.6
			s.PlaybackSpeed = 0.28
		end
		s.Parent = Workspace.CurrentCamera
		s:Play()
		game:GetService("Debris"):AddItem(s, 8)
		Efectos.Temblor(0.25, 1.2)
	end)
end

local function relampago()
	local cam = Workspace.CurrentCamera
	local base = cam.CFrame.Position
	local destino = base + Vector3.new(math.random(-160, 160), -10, math.random(-160, 160))
	Efectos.Rayo(destino, Color3.fromRGB(220, 230, 255))
	-- destello de luz global
	local brillo = Lighting.Brightness
	Lighting.Brightness = 4
	Lighting.Ambient = Color3.fromRGB(150, 160, 200)
	Efectos.FlashPantalla(Color3.fromRGB(200, 210, 255), 0.5)
	task.delay(0.08, function()
		if activo then
			Lighting.Brightness = brillo
			Lighting.Ambient = Config.Color(A.Ambient)
		end
	end)
	task.delay(0.16, function() -- doble parpadeo
		if activo then
			Lighting.Brightness = 2.5
			task.wait(0.06)
			if activo then
				Lighting.Brightness = brillo
			end
		end
	end)
	trueno(0.4 + math.random() * 1.2)
end

local function crearLluvia()
	local caja = crear("Part", {
		Name = "Lluvia", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(140, 1, 140),
	}, Efectos.Carpeta)
	crear("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(170, 185, 210)),
		LightEmission = 0.3,
		Transparency = NumberSequence.new(0.35),
		Size = NumberSequence.new(0.12),
		Squash = NumberSequence.new(3),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Lifetime = NumberRange.new(0.9, 1.1),
		Speed = NumberRange.new(90, 110),
		Acceleration = Vector3.new(4, 0, 2),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(3, 3),
		Rate = A.LluviaRate,
	}, caja)
	-- salpicaduras en el suelo alrededor del jugador
	local suelo = crear("Part", {
		Name = "Salpicaduras", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(60, 0.2, 60),
	}, Efectos.Carpeta)
	crear("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(190, 200, 220)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.35) }),
		Lifetime = NumberRange.new(0.15, 0.25),
		Speed = NumberRange.new(4, 7),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -30, 0),
		Rate = 250,
	}, suelo)
	table.insert(conexiones, RunService.RenderStepped:Connect(function()
		local p = Workspace.CurrentCamera.CFrame.Position
		caja.CFrame = CFrame.new(p + Vector3.new(0, 60, 0))
		local personaje = game:GetService("Players").LocalPlayer.Character
		local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
		if raiz then
			suelo.CFrame = CFrame.new(raiz.Position.X, raiz.Position.Y - 2.9, raiz.Position.Z)
		end
	end))
end

function Ambiente.Activar()
	if activo then
		return
	end
	activo = true
	guardado = {}
	for _, prop in ipairs(PROPS) do
		guardado[prop] = Lighting[prop]
	end
	-- Desactivar cielos/atmósferas/efectos existentes (se restauran luego)
	for _, hijo in ipairs(Lighting:GetChildren()) do
		if hijo:IsA("Sky") or hijo:IsA("Atmosphere") then
			table.insert(ocultos, { Instancia = hijo, Padre = hijo.Parent })
			hijo.Parent = nil
		elseif hijo:IsA("PostEffect") and hijo.Enabled then
			table.insert(ocultos, { Instancia = hijo, Enabled = true })
			hijo.Enabled = false
		end
	end
	local nubesOriginales = Workspace.Terrain:FindFirstChildOfClass("Clouds")
	if nubesOriginales then
		table.insert(ocultos, { Instancia = nubesOriginales, Padre = Workspace.Terrain })
		nubesOriginales.Parent = nil
	end

	Lighting.ClockTime = A.ClockTime
	Lighting.Brightness = A.Brightness
	Lighting.Ambient = Config.Color(A.Ambient)
	Lighting.OutdoorAmbient = Config.Color(A.OutdoorAmbient)
	Lighting.FogColor = Config.Color(A.FogColor)
	Lighting.FogStart = A.FogStart
	Lighting.FogEnd = A.FogEnd
	Lighting.ExposureCompensation = -0.3
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true

	crear("Sky", { CelestialBodiesShown = false, StarCount = 0 }, Lighting)
	crear("Atmosphere", {
		Density = A.DensidadAtmosfera, Offset = 0.1, Haze = 3, Glare = 0,
		Color = Color3.fromRGB(60, 65, 80), Decay = Color3.fromRGB(25, 25, 35),
	}, Lighting)
	crear("ColorCorrectionEffect", { Contrast = 0.2, Saturation = -0.45, TintColor = Color3.fromRGB(200, 210, 235) }, Lighting)
	crear("BloomEffect", { Intensity = 0.8, Size = 30, Threshold = 1.2 }, Lighting)
	crear("Clouds", { Cover = 0.95, Density = 0.9, Color = Color3.fromRGB(40, 42, 50) }, Workspace.Terrain)

	crearLluvia()

	local lluvia = sonidoLocal(Config.Sonidos.Lluvia, 0.6, true)
	if lluvia then
		lluvia:Play()
	end
	local musica = sonidoLocal(Config.Sonidos.MusicaDuelo, 0.8, true)
	if musica then
		musica:Play()
	end

	task.spawn(function()
		task.wait(1)
		while activo do
			relampago()
			task.wait(math.random(A.Relampago.Min * 10, A.Relampago.Max * 10) / 10)
		end
	end)
end

function Ambiente.Desactivar()
	if not activo then
		return
	end
	activo = false
	for _, c in ipairs(conexiones) do
		c:Disconnect()
	end
	conexiones = {}
	for _, i in ipairs(creados) do
		i:Destroy()
	end
	creados = {}
	for prop, valor in pairs(guardado) do
		Lighting[prop] = valor
	end
	for _, o in ipairs(ocultos) do
		if o.Padre then
			o.Instancia.Parent = o.Padre
		elseif o.Enabled ~= nil then
			o.Instancia.Enabled = o.Enabled
		end
	end
	ocultos = {}
end

function Ambiente.Activo()
	return activo
end

return Ambiente
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1318">
          <Properties>
            <string name="Name">Duelo</string>
            <string name="Source"><![CDATA[--[[
	Duelo (cliente) — fases que manda el servidor por Remotes.DueloEstado:
	  Intro  → ambiente de tormenta + cámara cinematográfica
	  Cuenta → 3, 2, 1
	  Lucha  → controles de espada (el servidor valida todo)
	  Fin    → cámara orbitando al ganador + pantalla de victoria/derrota
	  Salir  → restaurar ambiente, cámara e interfaz
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local AnimPlayer = require(ReplicatedStorage:WaitForChild("AnimPlayer"))
local UI = require(script.Parent.UI)
local Efectos = require(script.Parent.Efectos)
local Ambiente = require(script.Parent.Ambiente)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local C = Config.Duelo
local jugador = Players.LocalPlayer
local Duelo = {}

local fase = nil
local rival = nil
local conexiones = {}
local cerrarResultado
local camaraCine -- conexión RenderStepped de la cámara
local bloqueoAnim
local comboIdx, ultimoLigero, cdLigero, cdPesado, cdEsquiva = 0, 0, 0, 0, 0

local function camara()
	return Workspace.CurrentCamera
end

local function pararCamaraCine()
	if camaraCine then
		camaraCine:Disconnect()
		camaraCine = nil
	end
	camara().CameraType = Enum.CameraType.Custom
	local h = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
	if h then
		camara().CameraSubject = h
	end
end

-- Recorrido de cámara por una lista de {CFrame, duración}
local function recorrido(planos)
	pararCamaraCine()
	local cam = camara()
	cam.CameraType = Enum.CameraType.Scriptable
	local inicio = os.clock()
	camaraCine = RunService.RenderStepped:Connect(function()
		local t = os.clock() - inicio
		for _, plano in ipairs(planos) do
			if t <= plano.Duracion then
				local alpha = TweenService:GetValue(t / plano.Duracion, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				cam.CFrame = plano.Desde:Lerp(plano.Hasta, alpha)
				cam.FieldOfView = plano.FOV or 60
				return
			end
			t -= plano.Duracion
		end
	end)
end

local function raizDe(p)
	return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function vidaCambiada()
	UI.Vida(true, jugador:GetAttribute("DueloVida") or 0, jugador:GetAttribute("DueloVidaMax") or C.Vida)
	if rival then
		UI.Vida(false, rival:GetAttribute("DueloVida") or 0, rival:GetAttribute("DueloVidaMax") or C.Vida)
	end
end

---------------------------------------------------------------- fases
local function intro(datos)
	rival = datos.Rival
	fase = "Intro"
	comboIdx, ultimoLigero, cdLigero, cdPesado, cdEsquiva = 0, 0, 0, 0, 0
	Ambiente.Activar()
	UI.MostrarPrincipal(false)
	UI.Cine(true)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
	UI.MostrarHUDDuelo(true, jugador.DisplayName, rival and rival.DisplayName or "Rival")
	table.insert(conexiones, jugador:GetAttributeChangedSignal("DueloVida"):Connect(vidaCambiada))
	if rival then
		table.insert(conexiones, rival:GetAttributeChangedSignal("DueloVida"):Connect(vidaCambiada))
	end
	vidaCambiada()

	local centro = datos.Centro
	local yoPos = (raizDe(jugador) and raizDe(jugador).Position) or centro
	local rivalPos = (raizDe(rival) and raizDe(rival).Position) or centro
	local d = datos.Duracion
	recorrido({
		{ -- gran plano aéreo girando sobre la arena
			Desde = CFrame.lookAt(centro + Vector3.new(-110, 70, -110), centro),
			Hasta = CFrame.lookAt(centro + Vector3.new(110, 45, -90), centro),
			Duracion = d * 0.45, FOV = 70,
		},
		{ -- primer plano del rival
			Desde = CFrame.lookAt(rivalPos + (yoPos - rivalPos).Unit * 9 + Vector3.new(3, 2, 0), rivalPos + Vector3.new(0, 1.5, 0)),
			Hasta = CFrame.lookAt(rivalPos + (yoPos - rivalPos).Unit * 6 + Vector3.new(1.5, 1.5, 0), rivalPos + Vector3.new(0, 1.8, 0)),
			Duracion = d * 0.3, FOV = 45,
		},
		{ -- por encima de tu hombro
			Desde = CFrame.lookAt(yoPos + Vector3.new(2, 3, 0) - (rivalPos - yoPos).Unit * 8, rivalPos),
			Hasta = CFrame.lookAt(yoPos + Vector3.new(2, 4, 0) - (rivalPos - yoPos).Unit * 12, rivalPos),
			Duracion = d * 0.25 + 1, FOV = 60,
		},
	})
end

local function cuenta(datos)
	fase = "Cuenta"
	pararCamaraCine()
	UI.Cine(false)
	for i = datos.Segundos, 1, -1 do
		UI.TextoGrande(tostring(i), Color3.new(1, 1, 1), 0.7)
		Efectos.Sonido(Config.Sonidos.Impacto, nil, 1, 0.6 + (datos.Segundos - i) * 0.1)
		task.wait(1)
		if fase ~= "Cuenta" then
			return
		end
	end
end

local function lucha()
	fase = "Lucha"
	UI.TextoGrande("¡LUCHA!", Color3.fromRGB(255, 70, 60), 0.9)
	Efectos.Temblor(0.6, 0.6)
	Efectos.Sonido(Config.Sonidos.Explosion, nil, 1.2, 0.7)
end

local function fin(datos)
	fase = "Fin"
	if bloqueoAnim then
		bloqueoAnim.Detener()
		bloqueoAnim = nil
	end
	UI.Cine(true)
	-- cámara lenta orbitando al ganador (o a ti si hay empate)
	local foco = datos.GanadorJugador or jugador
	local inicio = os.clock()
	pararCamaraCine()
	camara().CameraType = Enum.CameraType.Scriptable
	camaraCine = RunService.RenderStepped:Connect(function()
		local raiz = raizDe(foco)
		if not raiz then
			return
		end
		local t = os.clock() - inicio
		local a = t * 0.35
		local dist = 14 - math.min(t, 4) * 1.2
		local pos = raiz.Position + Vector3.new(math.cos(a) * dist, 3 + math.sin(t * 0.5), math.sin(a) * dist)
		camara().CFrame = CFrame.lookAt(pos, raiz.Position + Vector3.new(0, 1.5, 0))
		camara().FieldOfView = 50
	end)
	task.delay(1.2, function()
		if fase == "Fin" then
			cerrarResultado = UI.Resultado(datos.Gane, datos.Empate, datos.Recompensa, datos.Ganador)
		end
	end)
end

local function salir()
	fase = nil
	rival = nil
	for _, c in ipairs(conexiones) do
		c:Disconnect()
	end
	conexiones = {}
	pararCamaraCine()
	camara().FieldOfView = 70
	Ambiente.Desactivar()
	UI.Cine(false)
	UI.MostrarHUDDuelo(false)
	UI.MostrarPrincipal(true)
	if cerrarResultado then
		cerrarResultado()
		cerrarResultado = nil
	end
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, true)
end

---------------------------------------------------------------- controles
local function enviar(accion)
	Remotes.DueloAccion:FireServer(accion)
end

local function personaje()
	return jugador.Character
end

local function ligero()
	local ahora = os.clock()
	if ahora < cdLigero or bloqueoAnim then
		return
	end
	cdLigero = ahora + C.ComboCooldown
	comboIdx = (ahora - ultimoLigero <= C.ComboVentana) and (comboIdx % #C.Combo + 1) or 1
	ultimoLigero = ahora
	AnimPlayer.Reproducir(personaje(), "Espada_Combo" .. comboIdx)
	enviar("Ligero")
end

local function pesado()
	local ahora = os.clock()
	if ahora < cdPesado or bloqueoAnim then
		return
	end
	cdPesado = ahora + C.Pesado.Cooldown
	cdLigero = ahora + C.Pesado.Retraso
	AnimPlayer.Reproducir(personaje(), "Espada_Pesado")
	enviar("Pesado")
end

local function esquivar()
	local ahora = os.clock()
	if ahora < cdEsquiva then
		return
	end
	cdEsquiva = ahora + C.Esquiva.Cooldown
	local h = personaje() and personaje():FindFirstChildOfClass("Humanoid")
	local raiz = raizDe(jugador)
	if not h or not raiz then
		return
	end
	local dir = h.MoveDirection.Magnitude > 0.1 and h.MoveDirection.Unit or -raiz.CFrame.LookVector
	AnimPlayer.Reproducir(personaje(), "Espada_Esquiva")
	Efectos.Dash(dir, C.Esquiva.Velocidad, 0.22)
	enviar("Esquiva")
end

local function coincide(entrada, tecla)
	if type(tecla) == "table" then
		for _, t in ipairs(tecla) do
			if coincide(entrada, t) then
				return true
			end
		end
		return false
	end
	return entrada.KeyCode.Name == tecla or entrada.UserInputType.Name == tecla
end

function Duelo.Iniciar()
	Remotes.DueloEstado.OnClientEvent:Connect(function(datos)
		if datos.Fase == "Intro" then
			intro(datos)
		elseif datos.Fase == "Cuenta" then
			task.spawn(cuenta, datos)
		elseif datos.Fase == "Lucha" then
			lucha()
		elseif datos.Fase == "Fin" then
			fin(datos)
		elseif datos.Fase == "Salir" then
			salir()
		end
	end)

	Remotes.DueloInvitacion.OnClientEvent:Connect(function(datos)
		UI.Pregunta("⚔ DUELO FINAL", ("¡Tú y %s tenéis la misma fuerza! ¿Aceptas el duelo en la Arena del Juramento?"):format(datos.Rival),
			datos.Tiempo, Color3.fromRGB(255, 80, 80), function(si)
				Remotes.DueloResponder:FireServer(si)
			end)
	end)

	UserInputService.InputBegan:Connect(function(entrada, procesado)
		if fase ~= "Lucha" or procesado then
			return
		end
		if entrada.UserInputType == Enum.UserInputType.MouseButton1 or entrada.UserInputType == Enum.UserInputType.Touch then
			ligero()
		elseif coincide(entrada, Config.Teclas.DueloPesado) then
			pesado()
		elseif coincide(entrada, Config.Teclas.DueloBloqueo) then
			if not bloqueoAnim then
				bloqueoAnim = AnimPlayer.Reproducir(personaje(), "Espada_Bloqueo") or { Detener = function() end }
				enviar("BloqueoOn")
			end
		elseif coincide(entrada, Config.Teclas.DueloEsquiva) then
			esquivar()
		end
	end)
	UserInputService.InputEnded:Connect(function(entrada)
		if coincide(entrada, Config.Teclas.DueloBloqueo) and bloqueoAnim then
			bloqueoAnim.Detener()
			bloqueoAnim = nil
			enviar("BloqueoOff")
		end
	end)
end

function Duelo.EnDuelo()
	return fase ~= nil
end

return Duelo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1319">
          <Properties>
            <string name="Name">Efectos</string>
            <string name="Source"><![CDATA[--[[
	Efectos — todo lo visual/sonoro local: screen shake, ondas expansivas, cráteres,
	escombros, chispas, tajos de espada, textos flotantes, empujes y dashes.
	Lo dispara el servidor con Remotes.Efecto (lo ven todos) o el propio cliente.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local jugador = Players.LocalPlayer
local Efectos = {}

local carpeta = Instance.new("Folder")
carpeta.Name = "EfectosLocales"
carpeta.Parent = Workspace

---------------------------------------------------------------- utilidades
local function tween(obj, t, props, estilo, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, estilo or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function parte(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = carpeta
	return p
end

function Efectos.Sonido(id, pos, volumen, velocidad)
	if not id or id == "" then
		return
	end
	local ancla = parte({ Transparency = 1, Size = Vector3.one, Position = pos or Workspace.CurrentCamera.CFrame.Position })
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volumen or 1
	s.PlaybackSpeed = velocidad or 1
	s.RollOffMaxDistance = 400
	s.Parent = ancla
	s:Play()
	Debris:AddItem(ancla, 6)
	return s
end

local function suelo(pos)
	local params = RaycastParams.new()
	local excluir = { carpeta }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(excluir, p.Character)
		end
	end
	params.FilterDescendantsInstances = excluir
	params.FilterType = Enum.RaycastFilterType.Exclude
	local r = Workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
	if r then
		return r.Position, r.Instance.Color, r.Instance.Material
	end
	return pos, Color3.fromRGB(90, 90, 90), Enum.Material.Slate
end

local function emisor(pos, props, cantidad, vida)
	local p = parte({ Transparency = 1, Size = Vector3.one, Position = pos })
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = p
	e:Emit(cantidad)
	Debris:AddItem(p, vida or 3)
	return e
end

local function chispas(pos, color, cantidad, velocidad)
	emisor(pos, {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.25, 0.6),
		Speed = NumberRange.new(velocidad * 0.5, velocidad),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
	}, cantidad)
end

local function polvo(pos, radio, cantidad)
	emisor(pos, {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(140, 125, 110)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, radio * 0.15), NumberSequenceKeypoint.new(1, radio * 0.45) }),
		Lifetime = NumberRange.new(1.2, 2.2),
		Speed = NumberRange.new(radio * 0.6, radio * 1.4),
		SpreadAngle = Vector2.new(180, 10),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 4, 0),
		Drag = 3,
		RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360),
	}, cantidad, 4)
end

local function destello(pos, color, tam, t)
	local b = parte({ Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = color, Size = Vector3.one * 2, Position = pos, Transparency = 0.1 })
	local luz = Instance.new("PointLight")
	luz.Color, luz.Brightness, luz.Range = color, 8, tam * 2
	luz.Parent = b
	tween(b, t, { Size = Vector3.one * tam, Transparency = 1 })
	tween(luz, t, { Brightness = 0 })
	Debris:AddItem(b, t + 0.1)
end

local function anillo(pos, radio, color, t, grosor, inclinado)
	local cil = parte({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color, Transparency = 0.15 })
	cil.Size = Vector3.new(grosor or 0.6, 2, 2)
	cil.CFrame = CFrame.new(pos) * (inclinado or CFrame.Angles(0, 0, math.rad(90)))
	tween(cil, t, { Size = Vector3.new(0.2, radio * 2, radio * 2), Transparency = 1 })
	Debris:AddItem(cil, t + 0.1)
end

local function crater(pos, radio, color, material, cantidad)
	for i = 1, cantidad do
		local a = (i / cantidad) * math.pi * 2 + math.random() * 0.3
		local r = radio * (0.55 + math.random() * 0.35)
		local tam = Vector3.new(2 + math.random() * radio * 0.18, 1.5 + math.random() * radio * 0.12, 2 + math.random() * radio * 0.18)
		local destino = CFrame.new(pos + Vector3.new(math.cos(a) * r, tam.Y * 0.2, math.sin(a) * r))
			* CFrame.Angles(math.rad(math.random(-35, 35)), a, math.rad(math.random(20, 50)))
		local roca = parte({ Size = tam, Color = color, Material = material, CanCollide = false })
		roca.CFrame = destino - Vector3.new(0, tam.Y, 0)
		tween(roca, 0.12, { CFrame = destino }, Enum.EasingStyle.Back)
		task.delay(3 + math.random(), function()
			tween(roca, 1, { CFrame = destino - Vector3.new(0, tam.Y + 1, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(roca, 1.1)
		end)
	end
	-- grieta central
	local grieta = parte({ Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(20, 15, 15), Material = Enum.Material.Slate })
	grieta.Size = Vector3.new(0.3, radio * 1.1, radio * 1.1)
	grieta.CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
	task.delay(4, function()
		tween(grieta, 1, { Transparency = 1 })
		Debris:AddItem(grieta, 1.1)
	end)
end

local function escombros(pos, cantidad, fuerza, color, material)
	for _ = 1, cantidad do
		local p = Instance.new("Part")
		p.Size = Vector3.one * (0.6 + math.random() * 1.4)
		p.Color, p.Material = color, material
		p.CanCollide = true
		p.CanQuery = false
		p.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		p.Parent = carpeta
		local dir = Vector3.new(math.random() - 0.5, 0.8 + math.random(), math.random() - 0.5).Unit
		p.AssemblyLinearVelocity = dir * fuerza * (0.5 + math.random() * 0.7)
		p.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
		Debris:AddItem(p, 3 + math.random())
	end
end

local function rayo(destino, color)
	local inicio = destino + Vector3.new(math.random(-20, 20), 140, math.random(-20, 20))
	local puntos, n = { inicio }, 9
	for i = 1, n - 1 do
		local alpha = i / n
		table.insert(puntos, inicio:Lerp(destino, alpha) + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)))
	end
	table.insert(puntos, destino)
	for i = 1, #puntos - 1 do
		local a, b = puntos[i], puntos[i + 1]
		local seg = parte({ Material = Enum.Material.Neon, Color = color })
		seg.Size = Vector3.new(0.8, 0.8, (b - a).Magnitude)
		seg.CFrame = CFrame.lookAt((a + b) / 2, b)
		tween(seg, 0.35, { Transparency = 1, Size = Vector3.new(0.1, 0.1, seg.Size.Z) })
		Debris:AddItem(seg, 0.4)
	end
end

local function textoFlotante(pos, texto, color, tam)
	local ancla = parte({ Transparency = 1, Size = Vector3.one, Position = pos })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 70)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = ancla
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.LuckiestGuy
	l.Text = texto
	l.TextColor3 = color
	l.TextStrokeTransparency = 0
	l.TextScaled = true
	l.Parent = bb
	local escala = Instance.new("UIScale")
	escala.Scale = 0.2
	escala.Parent = l
	tween(escala, 0.25, { Scale = tam or 1 }, Enum.EasingStyle.Back)
	tween(ancla, 1.2, { Position = pos + Vector3.new(0, 4, 0) })
	task.delay(0.7, function()
		tween(l, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(ancla, 1.3)
end
Efectos.TextoFlotante = textoFlotante

---------------------------------------------------------------- screen shake
local temblores = {}
RunService:BindToRenderStep("TemblorCamara", Enum.RenderPriority.Camera.Value + 1, function()
	local ahora = os.clock()
	local total = 0
	for i = #temblores, 1, -1 do
		local t = temblores[i]
		local alpha = (ahora - t.Inicio) / t.Duracion
		if alpha >= 1 then
			table.remove(temblores, i)
		else
			total += t.Intensidad * (1 - alpha) ^ 2
		end
	end
	if total > 0.001 then
		local cam = Workspace.CurrentCamera
		local n = ahora * 28
		local rx = (math.noise(n, 0.3) * 2) * total
		local ry = (math.noise(0.7, n) * 2) * total
		local rz = (math.noise(n, n * 0.5) * 1) * total
		cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(rx * 3), math.rad(ry * 3), math.rad(rz * 2))
	end
end)

function Efectos.Temblor(intensidad, duracion)
	if intensidad <= 0 then
		return
	end
	table.insert(temblores, { Intensidad = intensidad, Duracion = duracion or 0.5, Inicio = os.clock() })
end

local function temblorPorDistancia(pos, fuerza, radio)
	local cam = Workspace.CurrentCamera
	local dist = (cam.Focus.Position - pos).Magnitude
	local alcance = (radio or 10) * 3 + 50
	local f = math.clamp(1 - dist / alcance, 0, 1)
	Efectos.Temblor(fuerza * f, 0.35 + fuerza * 0.4)
end

local function flashPantalla(color, intensidad)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = color
	cc.Brightness = intensidad
	cc.Parent = game:GetService("Lighting")
	tween(cc, 0.45, { Brightness = 0, TintColor = Color3.new(1, 1, 1) })
	Debris:AddItem(cc, 0.5)
end

---------------------------------------------------------------- física local
local function velocidadTemporal(vel, duracion)
	local personaje = jugador.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end
	local att = raiz:FindFirstChild("RootAttachment") or Instance.new("Attachment", raiz)
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.VectorVelocity = vel
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.Parent = raiz
	Debris:AddItem(lv, duracion)
end

function Efectos.Empuje(vel)
	velocidadTemporal(vel, 0.15)
end

function Efectos.Dash(direccion, velocidad, duracion)
	velocidadTemporal(direccion * velocidad, duracion)
end

---------------------------------------------------------------- tipos de efecto
local COLORES = {
	PunoPotente = Color3.fromRGB(255, 200, 80),
	PatadaGiratoria = Color3.fromRGB(120, 220, 255),
	Embestida = Color3.fromRGB(255, 120, 60),
	OndaExpansiva = Color3.fromRGB(160, 120, 255),
	SaltoSismico = Color3.fromRGB(255, 90, 40),
	FuriaTitan = Color3.fromRGB(255, 40, 40),
}

local manejadores = {}

function manejadores.Carga(d)
	local personaje = d.Origen and d.Origen.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end
	local color = COLORES[d.Id] or Color3.new(1, 1, 1)
	emisor(raiz.Position, {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(-14, -8), -- hacia dentro: concentrando poder
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
	}, 40, 1.5)
	if d.Id == "FuriaTitan" or d.Id == "SaltoSismico" then
		temblorPorDistancia(raiz.Position, 0.4, 20)
	end
end

function manejadores.Golpe(d)
	destello(d.Pos, COLORES.PunoPotente, 9, 0.3)
	anillo(d.Pos, 7, COLORES.PunoPotente, 0.35, 0.5, CFrame.lookAt(Vector3.zero, d.Dir) * CFrame.Angles(0, math.rad(90), 0))
	chispas(d.Pos, COLORES.PunoPotente, 30, 50)
	Efectos.Sonido(Config.Sonidos.Impacto, d.Pos, 1.4, 0.7)
	temblorPorDistancia(d.Pos, d.Fuerza, d.Radio)
end

function manejadores.Giro(d)
	local pos = suelo(d.Pos)
	anillo(pos + Vector3.new(0, 1.5, 0), d.Radio, COLORES.PatadaGiratoria, 0.4, 0.6)
	polvo(pos, d.Radio, 20)
	Efectos.Sonido(Config.Sonidos.Estocada, pos, 1.3, 0.8)
	temblorPorDistancia(pos, d.Fuerza, d.Radio)
end

function manejadores.Embestida(d)
	local pos = suelo(d.Pos)
	destello(d.Pos, COLORES.Embestida, 14, 0.35)
	anillo(pos + Vector3.new(0, 1, 0), d.Radio * 2, COLORES.Embestida, 0.4)
	polvo(pos, 12, 25)
	Efectos.Sonido(Config.Sonidos.Impacto, pos, 2, 0.5)
	temblorPorDistancia(pos, d.Fuerza, 15)
end

function manejadores.Onda(d)
	local pos, color, material = suelo(d.Pos)
	destello(pos, COLORES.OndaExpansiva, 18, 0.4)
	anillo(pos + Vector3.new(0, 1, 0), d.Radio, COLORES.OndaExpansiva, 0.6, 1)
	task.delay(0.1, anillo, pos + Vector3.new(0, 0.5, 0), d.Radio * 1.2, Color3.new(1, 1, 1), 0.7, 0.5)
	crater(pos, 9, color, material, 14)
	polvo(pos, d.Radio, 45)
	escombros(pos, 10, 55, color, material)
	flashPantalla(COLORES.OndaExpansiva, 0.25)
	Efectos.Sonido(Config.Sonidos.Explosion, pos, 2, 0.6)
	temblorPorDistancia(pos, d.Fuerza, d.Radio)
end

function manejadores.Sismo(d)
	local pos, color, material = suelo(d.Pos)
	destello(pos, COLORES.SaltoSismico, 26, 0.45)
	for i = 0, 2 do
		task.delay(i * 0.12, anillo, pos + Vector3.new(0, 1, 0), d.Radio * (0.6 + i * 0.3), COLORES.SaltoSismico, 0.7, 1.2)
	end
	crater(pos, 16, color, material, 24)
	polvo(pos, d.Radio, 70)
	escombros(pos, 22, 85, color, material)
	flashPantalla(Color3.fromRGB(255, 150, 100), 0.35)
	Efectos.Sonido(Config.Sonidos.Explosion, pos, 3, 0.4)
	Efectos.Sonido(Config.Sonidos.Impacto, pos, 3, 0.3)
	temblorPorDistancia(pos, d.Fuerza, d.Radio)
end

function manejadores.Titan(d)
	local pos, color, material = suelo(d.Pos)
	flashPantalla(Color3.fromRGB(255, 80, 60), 0.6)
	for i = 0, 3 do
		task.delay(i * 0.18, function()
			anillo(pos + Vector3.new(0, 1 + i, 0), d.Radio * (0.4 + i * 0.25), i % 2 == 0 and COLORES.FuriaTitan or Color3.new(1, 0.85, 0.6), 0.8, 1.6)
			temblorPorDistancia(pos, d.Fuerza * 0.6, d.Radio)
		end)
	end
	for i = 1, 8 do
		task.delay(0.05 * i, function()
			local a = math.random() * math.pi * 2
			local p = suelo(pos + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(8, d.Radio))
			rayo(p, Color3.fromRGB(255, 220, 220))
			destello(p, COLORES.FuriaTitan, 10, 0.3)
			crater(p, 5, color, material, 7)
		end)
	end
	destello(pos, COLORES.FuriaTitan, 40, 0.6)
	crater(pos, 22, color, material, 30)
	polvo(pos, d.Radio, 90)
	escombros(pos, 30, 110, color, material)
	Efectos.Sonido(Config.Sonidos.Explosion, pos, 4, 0.3)
	temblorPorDistancia(pos, d.Fuerza, d.Radio)
end

function manejadores.Impacto(d)
	chispas(d.Pos, Color3.fromRGB(255, 230, 150), 15, 30)
	textoFlotante(d.Pos + Vector3.new(0, 2, 0), "¡POW!", Color3.fromRGB(255, 220, 90), 0.8)
end

function manejadores.Tajo(d)
	local personaje = d.Origen and d.Origen.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end
	local color = d.Pesado and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(180, 220, 255)
	local radio = d.Pesado and 9 or 7
	-- Arco de tajo: segmentos neón en semicírculo delante del atacante
	for i = -4, 4 do
		local a = math.rad(i * 18)
		local cf = raiz.CFrame * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.5, -radio * 0.6)
		local seg = parte({ Material = Enum.Material.Neon, Color = color, Transparency = 0.25, Size = Vector3.new(0.15, 0.5, radio * 0.25), CFrame = cf * CFrame.Angles(0, math.rad(90), 0) })
		tween(seg, 0.22, { Transparency = 1, Size = Vector3.new(0.05, 0.1, seg.Size.Z) })
		Debris:AddItem(seg, 0.25)
	end
	Efectos.Sonido(d.Pesado and Config.Sonidos.Estocada or Config.Sonidos.Tajo, raiz.Position, 1, d.Pesado and 0.7 or 1 + math.random() * 0.15)
end

function manejadores.CargaPesado(d)
	local personaje = d.Origen and d.Origen.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if raiz then
		emisor(raiz.Position, {
			Color = ColorSequence.new(Color3.fromRGB(255, 120, 60)),
			LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) }),
			Lifetime = NumberRange.new(0.3, 0.6),
			Speed = NumberRange.new(-12, -6),
			SpreadAngle = Vector2.new(180, 180),
			Shape = Enum.ParticleEmitterShape.Sphere,
		}, 25, 1)
	end
end

function manejadores.GolpeEspada(d)
	if d.Bloqueado then
		chispas(d.Pos, Color3.fromRGB(255, 230, 120), 35, 40)
		textoFlotante(d.Pos + Vector3.new(0, 3, 0), "BLOQUEADO -" .. d.Dano, Color3.fromRGB(200, 220, 255), 0.7)
		Efectos.Sonido(Config.Sonidos.Impacto, d.Pos, 1.2, 1.6)
	else
		chispas(d.Pos, Color3.fromRGB(255, 70, 60), d.Pesado and 45 or 20, d.Pesado and 55 or 35)
		destello(d.Pos, Color3.fromRGB(255, 200, 200), d.Pesado and 8 or 4, 0.2)
		textoFlotante(d.Pos + Vector3.new(0, 3, 0), "-" .. d.Dano, d.Pesado and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(255, 80, 80), d.Pesado and 1.2 or 0.9)
		Efectos.Sonido(Config.Sonidos.Impacto, d.Pos, 1.5, d.Pesado and 0.6 or 0.9)
	end
	temblorPorDistancia(d.Pos, d.Fuerza, 6)
end

function manejadores.Texto(d)
	textoFlotante(d.Pos, d.Texto, Color3.fromRGB(255, 255, 255), 1.1)
end

function Efectos.Procesar(d)
	local fn = manejadores[d.Tipo]
	if fn then
		task.spawn(fn, d)
	end
end

-- Exportadas para Ambiente (relámpagos de la arena)
Efectos.Rayo = rayo
Efectos.FlashPantalla = flashPantalla
Efectos.Tween = tween
Efectos.Carpeta = carpeta

return Efectos
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1320">
          <Properties>
            <string name="Name">Mentoria</string>
            <string name="Source"><![CDATA[--[[
	Mentoria — si estás en un club, tu compañero está en este servidor y eres claramente
	más fuerte, te sale el objetivo "Ayuda a [nombre] a volverse fuerte" con:
	 • un marcador sobre el aprendiz (visible a través de paredes)
	 • una flecha 3D flotante que apunta hacia él
	Es solo un aviso: se puede cerrar con la X (vuelve si cambia el compañero o reapareces).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local UI = require(script.Parent.UI)

local jugador = Players.LocalPlayer
local Mentoria = {}

local cerradoPara = nil -- UserId del aprendiz cuyo aviso se cerró
local marcador, flecha
local aprendizActual

local function crearMarcador()
	local bb = Instance.new("BillboardGui")
	bb.Name = "MarcadorAprendiz"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(160, 60)
	bb.StudsOffset = Vector3.new(0, 4.5, 0)
	bb.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.LuckiestGuy
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 205, 70)
	l.TextStrokeTransparency = 0
	l.Text = "APRENDIZ\n▼"
	l.Parent = bb
	return bb
end

local function crearFlecha()
	local m = Instance.new("Model")
	m.Name = "FlechaMentor"
	local function p(tam, cf, clase)
		local x = Instance.new(clase or "Part")
		x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch, x.CastShadow = true, false, false, false, false
		x.Material = Enum.Material.Neon
		x.Color = Color3.fromRGB(255, 205, 70)
		x.Size = tam
		x:SetAttribute("Offset", cf)
		x.Parent = m
		return x
	end
	-- cuerpo + dos cuñas formando la punta (apunta a -Z)
	p(Vector3.new(0.5, 0.25, 2), CFrame.new(0, 0, 0.6))
	p(Vector3.new(0.25, 0.9, 1.1), CFrame.new(-0.45, 0, -0.85) * CFrame.Angles(0, 0, math.rad(90)), "WedgePart")
	p(Vector3.new(0.25, 0.9, 1.1), CFrame.new(0.45, 0, -0.85) * CFrame.Angles(0, 0, math.rad(-90)), "WedgePart")
	m.Parent = Workspace
	return m
end

local function colocarFlecha(cf)
	for _, x in ipairs(flecha:GetChildren()) do
		x.CFrame = cf * x:GetAttribute("Offset")
	end
end

local function ocultar()
	UI.AvisoMentor(false)
	if marcador then
		marcador.Parent = nil
	end
	if flecha then
		flecha.Parent = nil
	end
	aprendizActual = nil
end

local function aprendiz()
	if jugador:GetAttribute("EnDuelo") then
		return nil
	end
	local id = jugador:GetAttribute("ClubCompaneroId") or 0
	if id == 0 then
		return nil
	end
	local otro = Players:GetPlayerByUserId(id)
	if not otro or (otro:GetAttribute("ClubCompaneroId") or 0) ~= jugador.UserId then
		return nil
	end
	local yo, el = jugador:GetAttribute("Fuerza") or 0, otro:GetAttribute("Fuerza") or 0
	if yo <= 0 or (yo - el) / yo < Config.Mentoria.DiferenciaParaAviso then
		return nil
	end
	return otro
end

function Mentoria.Iniciar()
	UI.AlCerrarAviso = function()
		local otro = aprendiz()
		cerradoPara = otro and otro.UserId
		ocultar()
	end
	jugador.CharacterAdded:Connect(function()
		cerradoPara = nil -- el aviso vuelve tras reaparecer (no es obligatorio, solo recordatorio)
	end)
	marcador = crearMarcador()
	flecha = crearFlecha()
	flecha.Parent = nil

	local acumulado = 0
	RunService.Heartbeat:Connect(function(dt)
		acumulado += dt
		local otro = aprendizActual
		if acumulado >= 0.5 then
			acumulado = 0
			otro = aprendiz()
			if not otro or otro.UserId == cerradoPara then
				ocultar()
				return
			end
			aprendizActual = otro
		end
		if not otro then
			return
		end
		local miRaiz = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
		local suRaiz = otro.Character and otro.Character:FindFirstChild("HumanoidRootPart")
		if not miRaiz or not suRaiz then
			return
		end
		local distancia = (suRaiz.Position - miRaiz.Position).Magnitude
		UI.AvisoMentor(true, otro.DisplayName, math.floor(distancia))
		if marcador.Parent ~= otro.Character then
			marcador.Adornee = otro.Character:FindFirstChild("Head") or suRaiz
			marcador.Parent = otro.Character
		end
		if distancia > Config.Mentoria.DistanciaBonus then
			flecha.Parent = Workspace
			local dir = (suRaiz.Position - miRaiz.Position) * Vector3.new(1, 0, 1)
			if dir.Magnitude > 0.1 then
				local origen = miRaiz.Position + dir.Unit * 4 + Vector3.new(0, 1.5 + math.sin(os.clock() * 4) * 0.25, 0)
				colocarFlecha(CFrame.lookAt(origen, origen + dir.Unit))
			end
		else
			flecha.Parent = nil -- ya estáis juntos: bonus activo
		end
	end)
end

return Mentoria
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1321">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	UI — toda la interfaz, creada por código:
	panel de Fuerza, barra de habilidades, avisos, desbloqueo épico, panel de Club,
	invitaciones, aviso de mentor, HUD del duelo, cuenta atrás y pantalla final.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local jugador = Players.LocalPlayer
local UI = {}

local FUENTE = Enum.Font.LuckiestGuy
local FUENTE2 = Enum.Font.GothamBold
local ORO = Color3.fromRGB(255, 205, 70)

---------------------------------------------------------------- helpers
local function nuevo(clase, props, hijos)
	local i = Instance.new(clase)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			i[k] = v
		end
	end
	for _, h in ipairs(hijos or {}) do
		h.Parent = i
	end
	if props and props.Parent then
		i.Parent = props.Parent
	end
	return i
end

local function esquinas(r)
	return nuevo("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end

local function borde(color, grosor)
	return nuevo("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = grosor or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function tween(obj, t, props, estilo, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, estilo or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function texto(props)
	local base = {
		BackgroundTransparency = 1, Font = FUENTE, TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.3, TextScaled = true,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return nuevo("TextLabel", base)
end

local function boton(props, alPulsar)
	local base = {
		Font = FUENTE, TextColor3 = Color3.new(1, 1, 1), TextScaled = true, AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(60, 140, 255),
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = nuevo("TextButton", base, { esquinas(8), borde(Color3.fromRGB(10, 10, 20), 2),
		nuevo("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }) })
	b.Activated:Connect(alPulsar)
	return b
end

local gui = nuevo("ScreenGui", {
	Name = "JuegoUI", ResetOnSpawn = false, IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = jugador:WaitForChild("PlayerGui"),
})
local guiTop = nuevo("ScreenGui", {
	Name = "JuegoUI_Top", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10,
	Parent = jugador.PlayerGui,
})
UI.Gui = gui

---------------------------------------------------------------- panel de fuerza
local panelFuerza = nuevo("Frame", {
	Name = "PanelFuerza", Size = UDim2.fromOffset(260, 92), Position = UDim2.fromOffset(16, 60),
	BackgroundColor3 = Color3.fromRGB(20, 20, 30), BackgroundTransparency = 0.25, Parent = gui,
}, { esquinas(12), borde(ORO, 2) })
texto({ Text = "FUERZA", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 6), TextColor3 = ORO, TextXAlignment = Enum.TextXAlignment.Left, Parent = panelFuerza })
local valorFuerza = texto({ Text = "0", Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = panelFuerza })
local barraFondo = nuevo("Frame", { Size = UDim2.new(1, -20, 0, 10), Position = UDim2.fromOffset(10, 62), BackgroundColor3 = Color3.fromRGB(50, 50, 60), Parent = panelFuerza }, { esquinas(5) })
local barra = nuevo("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = ORO, Parent = barraFondo }, { esquinas(5) })
local siguienteTxt = texto({ Text = "", Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 74), Font = FUENTE2, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(200, 200, 210), Parent = panelFuerza })

function UI.ActualizarFuerza(valor)
	local anterior = tonumber((valorFuerza.Text:gsub("%D", ""))) or 0
	valorFuerza.Text = tostring(valor)
	if valor > anterior then
		local s = valorFuerza:FindFirstChildOfClass("UIScale") or nuevo("UIScale", { Parent = valorFuerza })
		s.Scale = 1.15
		tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local previa, siguiente = 0, nil
	for _, h in ipairs(Config.Habilidades) do
		if valor < h.Fuerza then
			siguiente = h
			break
		end
		previa = h.Fuerza
	end
	if siguiente then
		local alpha = math.clamp((valor - previa) / math.max(siguiente.Fuerza - previa, 1), 0, 1)
		tween(barra, 0.2, { Size = UDim2.fromScale(alpha, 1) })
		siguienteTxt.Text = ("Siguiente: %s (%d/%d)"):format(siguiente.Nombre, valor, siguiente.Fuerza)
	else
		barra.Size = UDim2.fromScale(1, 1)
		siguienteTxt.Text = "¡Todas las habilidades desbloqueadas!"
	end
end

---------------------------------------------------------------- barra de habilidades
local hotbar = nuevo("Frame", {
	Name = "Habilidades", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.fromOffset(#Config.Habilidades * 86, 86), BackgroundTransparency = 1, Parent = gui,
}, { nuevo("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
local slots = {}
for i, h in ipairs(Config.Habilidades) do
	local slot = nuevo("Frame", { Name = h.Id, LayoutOrder = i, Size = UDim2.fromOffset(80, 80), BackgroundColor3 = Color3.fromRGB(25, 25, 35), BackgroundTransparency = 0.15, Parent = hotbar }, { esquinas(10), borde(Color3.fromRGB(90, 90, 110), 2) })
	texto({ Text = h.Tecla, Size = UDim2.fromOffset(24, 22), Position = UDim2.fromOffset(4, 2), TextColor3 = ORO, Parent = slot })
	texto({ Text = h.Nombre, Size = UDim2.new(1, -8, 0, 32), Position = UDim2.fromOffset(4, 28), Font = FUENTE2, Parent = slot })
	local cd = nuevo("Frame", { Name = "CD", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 3, Parent = slot }, { esquinas(10) })
	local bloqueo = nuevo("Frame", { Name = "Bloqueo", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 10, 15), BackgroundTransparency = 0.2, ZIndex = 4, Parent = slot }, { esquinas(10) })
	texto({ Text = "🔒\n" .. h.Fuerza, Size = UDim2.fromScale(1, 0.8), Position = UDim2.fromScale(0, 0.1), TextColor3 = Color3.fromRGB(170, 170, 180), ZIndex = 5, Parent = bloqueo })
	slots[h.Id] = { Slot = slot, CD = cd, Bloqueo = bloqueo }
end

function UI.ActualizarHabilidades(desbloqueadas)
	for id, s in pairs(slots) do
		s.Bloqueo.Visible = not desbloqueadas[id]
	end
end

function UI.Cooldown(id, duracion)
	local s = slots[id]
	if not s then
		return
	end
	s.CD.Size = UDim2.fromScale(1, 1)
	tween(s.CD, duracion, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Linear)
	local st = s.Slot:FindFirstChildOfClass("UIStroke")
	st.Color = Color3.new(1, 1, 1)
	tween(st, 0.4, { Color = Color3.fromRGB(90, 90, 110) })
end

function UI.MostrarHotbar(visible)
	hotbar.Visible = visible
end

---------------------------------------------------------------- mensajes
local listaMensajes = nuevo("Frame", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(520, 200),
	BackgroundTransparency = 1, Parent = guiTop,
}, { nuevo("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })

function UI.Mensaje(t, color)
	local f = nuevo("Frame", { Size = UDim2.fromOffset(500, 34), BackgroundColor3 = Color3.fromRGB(15, 15, 25), BackgroundTransparency = 0.2, Parent = listaMensajes }, { esquinas(8), borde(color or Color3.new(1, 1, 1), 1.5) })
	local l = texto({ Text = t, Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Font = FUENTE2, TextColor3 = color or Color3.new(1, 1, 1), Parent = f })
	task.delay(3.5, function()
		tween(f, 0.4, { BackgroundTransparency = 1 })
		tween(l, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.45)
		f:Destroy()
	end)
end

function UI.Ganancia(cantidad, bonus, textoExtra)
	local l = texto({
		Text = (textoExtra and (textoExtra .. " ") or "") .. "+" .. cantidad .. " FUERZA" .. (bonus and ("  x" .. bonus .. " MENTOR") or ""),
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5 + (math.random() - 0.5) * 0.1, 0, 0.62, 0),
		Size = UDim2.fromOffset(420, 40), TextColor3 = bonus and Color3.fromRGB(120, 255, 160) or ORO, Parent = gui,
	})
	tween(l, 1.1, { Position = l.Position - UDim2.fromScale(0, 0.12) })
	task.delay(0.6, function()
		tween(l, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	game:GetService("Debris"):AddItem(l, 1.2)
end

---------------------------------------------------------------- desbloqueo épico
function UI.Desbloqueo(nombre, tecla)
	local fondo = nuevo("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 20, Parent = guiTop })
	local flash = nuevo("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 25, Parent = fondo })
	local rayos = nuevo("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(900, 900),
		BackgroundTransparency = 1, Image = "rbxasset://textures/particles/sparkles_main.dds",
		ImageColor3 = ORO, ImageTransparency = 0.3, ZIndex = 21, Parent = fondo,
	})
	local titulo = texto({ Text = "¡HABILIDAD DESBLOQUEADA!", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.33), Size = UDim2.fromScale(0.8, 0.08), TextColor3 = Color3.new(1, 1, 1), ZIndex = 22, Parent = fondo })
	local nombreL = texto({ Text = nombre:upper(), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.fromScale(0.9, 0.16), TextColor3 = ORO, ZIndex = 22, Parent = fondo })
	nuevo("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 150)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 40)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 150)) }), Parent = nombreL })
	nuevo("UIStroke", { Thickness = 4, Color = Color3.fromRGB(60, 20, 0), Parent = nombreL })
	local sub = texto({ Text = "Pulsa [" .. tecla .. "] para usarla", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromScale(0.5, 0.05), Font = FUENTE2, ZIndex = 22, TextTransparency = 1, Parent = fondo })
	local escala = nuevo("UIScale", { Scale = 3, Parent = nombreL })
	nombreL.Rotation = -8
	tween(fondo, 0.2, { BackgroundTransparency = 0.45 })
	tween(flash, 0.5, { BackgroundTransparency = 1 })
	tween(escala, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(nombreL, 0.45, { Rotation = 0 }, Enum.EasingStyle.Back)
	tween(sub, 0.4, { TextTransparency = 0 })
	local girando = true
	task.spawn(function()
		while girando do
			rayos.Rotation += 1.5
			task.wait()
		end
	end)
	local s = Instance.new("Sound")
	s.SoundId = Config.Sonidos.Desbloqueo
	s.Volume = 1.5
	s.Parent = guiTop
	s:Play()
	local s2 = Instance.new("Sound")
	s2.SoundId = Config.Sonidos.Explosion
	s2.PlaybackSpeed = 0.5
	s2.Parent = guiTop
	s2:Play()
	task.delay(2.8, function()
		tween(fondo, 0.4, { BackgroundTransparency = 1 })
		for _, l in ipairs({ titulo, nombreL, sub }) do
			tween(l, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		tween(rayos, 0.4, { ImageTransparency = 1 })
		task.wait(0.45)
		girando = false
		fondo:Destroy()
		s:Destroy()
		s2:Destroy()
	end)
end

---------------------------------------------------------------- pregunta (invitaciones)
-- callback(true|false). Se cierra sola al agotar el tiempo (= rechazar).
function UI.Pregunta(titulo, cuerpo, tiempo, colorAcento, callback)
	local f = nuevo("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(420, 180),
		BackgroundColor3 = Color3.fromRGB(20, 20, 30), Parent = guiTop,
	}, { esquinas(14), borde(colorAcento, 3) })
	texto({ Text = titulo, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 10), TextColor3 = colorAcento, Parent = f })
	texto({ Text = cuerpo, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 50), Font = FUENTE2, TextWrapped = true, Parent = f })
	local tiempoBarra = nuevo("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 106), BackgroundColor3 = colorAcento, Parent = f }, { esquinas(3) })
	local respondido = false
	local function responder(si)
		if respondido then
			return
		end
		respondido = true
		f:Destroy()
		callback(si)
	end
	boton({ Text = "ACEPTAR", Size = UDim2.new(0.5, -15, 0, 48), Position = UDim2.fromOffset(10, 120), BackgroundColor3 = Color3.fromRGB(60, 190, 90) }, function()
		responder(true)
	end).Parent = f
	boton({ Text = "RECHAZAR", Size = UDim2.new(0.5, -15, 0, 48), Position = UDim2.new(0.5, 5, 0, 120), BackgroundColor3 = Color3.fromRGB(200, 60, 60) }, function()
		responder(false)
	end).Parent = f
	local s = nuevo("UIScale", { Scale = 0.3, Parent = f })
	tween(s, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(tiempoBarra, tiempo, { Size = UDim2.new(0, 0, 0, 6) }, Enum.EasingStyle.Linear)
	task.delay(tiempo, function()
		responder(false)
	end)
end

---------------------------------------------------------------- aviso de mentor
local aviso = nuevo("Frame", {
	Name = "AvisoMentor", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(480, 62),
	BackgroundColor3 = Color3.fromRGB(30, 25, 10), BackgroundTransparency = 0.15, Visible = false, Parent = gui,
}, { esquinas(12), borde(ORO, 2) })
local avisoTxt = texto({ Text = "", Size = UDim2.new(1, -60, 0, 30), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = ORO, Parent = aviso })
local avisoSub = texto({ Text = "", Size = UDim2.new(1, -60, 0, 20), Position = UDim2.fromOffset(12, 36), Font = FUENTE2, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(230, 220, 190), Parent = aviso })
UI.AlCerrarAviso = nil
boton({ Text = "X", Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -46, 0, 13), BackgroundColor3 = Color3.fromRGB(90, 70, 40) }, function()
	aviso.Visible = false
	if UI.AlCerrarAviso then
		UI.AlCerrarAviso()
	end
end).Parent = aviso

function UI.AvisoMentor(visible, nombre, distancia)
	aviso.Visible = visible
	if visible then
		avisoTxt.Text = "🎯 Ayuda a " .. nombre .. " a volverse fuerte"
		avisoSub.Text = ("Entrenad cerca (<%d studs): ¡x%d de fuerza para tu aprendiz!%s"):format(
			Config.Mentoria.DistanciaBonus, Config.Mentoria.BonusAprendiz, distancia and ("  ·  a %d studs"):format(distancia) or "")
	end
end

---------------------------------------------------------------- panel de club
local panelClub = nuevo("Frame", {
	Name = "PanelClub", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(340, 400),
	BackgroundColor3 = Color3.fromRGB(18, 18, 28), BackgroundTransparency = 0.05, Visible = false, Parent = gui,
}, { esquinas(14), borde(Color3.fromRGB(110, 170, 255), 2) })
texto({ Text = "CLUB", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), TextColor3 = Color3.fromRGB(140, 190, 255), Parent = panelClub })
local contenido = nuevo("Frame", { Size = UDim2.new(1, -20, 1, -56), Position = UDim2.fromOffset(10, 48), BackgroundTransparency = 1, Parent = panelClub })

UI.Acciones = {} -- Invitar(userId), Salir(), Retar(), PedirEstado() -> estado

local function limpiarContenido()
	for _, h in ipairs(contenido:GetChildren()) do
		h:Destroy()
	end
end

local confirmarSalir = false
function UI.RefrescarClub()
	if not panelClub.Visible or not UI.Acciones.PedirEstado then
		return
	end
	local estado = UI.Acciones.PedirEstado()
	limpiarContenido()
	if not estado then
		texto({ Text = "Cargando...", Size = UDim2.new(1, 0, 0, 30), Font = FUENTE2, Parent = contenido })
		return
	end
	if not estado.Club then
		texto({ Text = "Invita a un amigo a tu club (mentor + aprendiz).", Size = UDim2.new(1, 0, 0, 40), Font = FUENTE2, TextWrapped = true, Parent = contenido })
		local lista = nuevo("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -50), Position = UDim2.fromOffset(0, 48), BackgroundTransparency = 1,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, Parent = contenido,
		}, { nuevo("UIListLayout", { Padding = UDim.new(0, 6) }) })
		local alguno = false
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= jugador then
				alguno = true
				local fila = nuevo("Frame", { Size = UDim2.new(1, -8, 0, 44), BackgroundColor3 = Color3.fromRGB(35, 35, 50), Parent = lista }, { esquinas(8) })
				local enClub = (p:GetAttribute("ClubCompaneroId") or 0) ~= 0
				texto({ Text = p.DisplayName .. "  ·  " .. tostring(p:GetAttribute("Fuerza") or 0), Size = UDim2.new(0.62, -8, 1, -12), Position = UDim2.fromOffset(8, 6), Font = FUENTE2, TextXAlignment = Enum.TextXAlignment.Left, Parent = fila })
				local b = boton({ Text = enClub and "EN CLUB" or "INVITAR", Size = UDim2.new(0.38, -8, 1, -10), Position = UDim2.new(0.62, 0, 0, 5), BackgroundColor3 = enClub and Color3.fromRGB(80, 80, 90) or Color3.fromRGB(60, 140, 255) }, function()
					if not enClub and UI.Acciones.Invitar then
						UI.Acciones.Invitar(p.UserId)
					end
				end)
				b.Parent = fila
			end
		end
		if not alguno then
			texto({ Text = "No hay más jugadores en el servidor. ¡Invita a un amigo al juego!", Size = UDim2.new(1, -8, 0, 60), Font = FUENTE2, TextWrapped = true, TextColor3 = Color3.fromRGB(180, 180, 190), Parent = lista })
		end
		return
	end
	local c = estado.Club
	local yo = estado.Fuerza
	local otro = c.FuerzaCompanero
	local rol = otro and (otro < yo and "Eres el MENTOR" or (otro > yo and "Eres el APRENDIZ" or "Mismo nivel")) or "Compañero desconectado"
	local lineas = {
		{ "Compañero: " .. c.CompaneroNombre, Color3.new(1, 1, 1) },
		{ c.EnServidor and "🟢 En este servidor" or "⚪ No está en este servidor", c.EnServidor and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(170, 170, 180) },
		{ rol, ORO },
		{ ("Fuerza: tú %d  ·  %s %s"):format(yo, c.CompaneroNombre, otro and tostring(otro) or "?"), Color3.new(1, 1, 1) },
		{ ("Días de mentoría: %.1f / %d"):format(c.Dias, c.DiasMinimos), Color3.fromRGB(200, 210, 255) },
	}
	for i, l in ipairs(lineas) do
		texto({ Text = l[1], Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, (i - 1) * 28), Font = FUENTE2, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = l[2], Parent = contenido })
	end
	local y = #lineas * 28 + 8
	texto({
		Text = c.DueloDisponible and "⚔ ¡DUELO FINAL DISPONIBLE!" or ("Duelo: " .. (c.MotivoDuelo or "")),
		Size = UDim2.new(1, 0, 0, 54), Position = UDim2.fromOffset(0, y), Font = c.DueloDisponible and FUENTE or FUENTE2,
		TextWrapped = true, TextColor3 = c.DueloDisponible and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(190, 190, 200), Parent = contenido,
	})
	boton({ Text = "⚔ RETAR A DUELO", Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, y + 62), BackgroundColor3 = c.DueloDisponible and Color3.fromRGB(190, 40, 40) or Color3.fromRGB(80, 60, 60) }, function()
		if UI.Acciones.Retar then
			UI.Acciones.Retar()
		end
	end).Parent = contenido
	local salir = boton({ Text = confirmarSalir and "¿SEGURO? PULSA OTRA VEZ" or "SALIR DEL CLUB", Size = UDim2.new(1, 0, 0, 38), Position = UDim2.fromOffset(0, y + 116), BackgroundColor3 = Color3.fromRGB(70, 70, 80) }, function()
		if confirmarSalir then
			confirmarSalir = false
			if UI.Acciones.Salir then
				UI.Acciones.Salir()
			end
			task.delay(0.5, UI.RefrescarClub)
		else
			confirmarSalir = true
			UI.RefrescarClub()
			task.delay(3, function()
				confirmarSalir = false
			end)
		end
	end)
	salir.Parent = contenido
end

local botonClub = boton({
	Name = "BotonClub", Text = "👥 CLUB", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 60),
	Size = UDim2.fromOffset(130, 46), BackgroundColor3 = Color3.fromRGB(60, 120, 230), Parent = gui,
}, function()
	panelClub.Visible = not panelClub.Visible
	UI.RefrescarClub()
end)
botonClub.Parent = gui
task.spawn(function()
	while true do
		task.wait(2)
		if panelClub.Visible then
			UI.RefrescarClub()
		end
	end
end)

---------------------------------------------------------------- duelo
local hudDuelo = nuevo("Frame", { Name = "HUDDuelo", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
local function barraVida(lado)
	local f = nuevo("Frame", {
		AnchorPoint = Vector2.new(lado == 1 and 0 or 1, 0), Position = lado == 1 and UDim2.new(0, 30, 0, 50) or UDim2.new(1, -30, 0, 50),
		Size = UDim2.new(0.4, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(30, 10, 10), Parent = hudDuelo,
	}, { esquinas(6), borde(Color3.new(0, 0, 0), 3) })
	local atraso = nuevo("Frame", { AnchorPoint = Vector2.new(lado == 1 and 0 or 1, 0), Position = UDim2.fromScale(lado == 1 and 0 or 1, 0), Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 240, 200), Parent = f }, { esquinas(6) })
	local relleno = nuevo("Frame", { AnchorPoint = Vector2.new(lado == 1 and 0 or 1, 0), Position = UDim2.fromScale(lado == 1 and 0 or 1, 0), Size = UDim2.fromScale(1, 1), BackgroundColor3 = lado == 1 and Color3.fromRGB(70, 200, 90) or Color3.fromRGB(220, 60, 60), Parent = f }, { esquinas(6) })
	local nombre = texto({ Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, -28), TextXAlignment = lado == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, Parent = f })
	local num = texto({ Text = "", Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Font = FUENTE2, TextXAlignment = lado == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, ZIndex = 3, Parent = f })
	return { Relleno = relleno, Atraso = atraso, Nombre = nombre, Num = num }
end
local vidaYo, vidaRival = barraVida(1), barraVida(2)
texto({ Text = "VS", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.fromOffset(80, 42), TextColor3 = Color3.fromRGB(255, 70, 70), Parent = hudDuelo })
texto({
	Text = "Clic: combo  ·  E / Clic dcho: ataque pesado  ·  F (mantener): bloquear  ·  Q: esquivar",
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.new(0.7, 0, 0, 22),
	Font = FUENTE2, TextColor3 = Color3.fromRGB(210, 210, 220), Parent = hudDuelo,
})

function UI.MostrarHUDDuelo(visible, nombreYo, nombreRival)
	hudDuelo.Visible = visible
	if nombreYo then
		vidaYo.Nombre.Text = nombreYo
		vidaRival.Nombre.Text = nombreRival
	end
end

function UI.Vida(esYo, vida, max)
	local b = esYo and vidaYo or vidaRival
	local alpha = math.clamp(vida / math.max(max, 1), 0, 1)
	b.Relleno.Size = UDim2.fromScale(alpha, 1)
	tween(b.Atraso, 0.6, { Size = UDim2.fromScale(alpha, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	b.Num.Text = ("%d / %d"):format(vida, max)
end

-- Barras de cine
local barraArriba = nuevo("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 15, Parent = guiTop })
local barraAbajo = nuevo("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 15, Parent = guiTop })
function UI.Cine(activo)
	local alto = activo and UDim2.fromScale(1, 0.12) or UDim2.fromScale(1, 0)
	tween(barraArriba, 0.6, { Size = alto })
	tween(barraAbajo, 0.6, { Size = alto })
end

function UI.TextoGrande(t, color, duracion)
	local l = texto({ Text = t, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.7, 0.2), TextColor3 = color or Color3.new(1, 1, 1), ZIndex = 18, Parent = guiTop })
	nuevo("UIStroke", { Thickness = 5, Color = Color3.new(0, 0, 0), Parent = l })
	local s = nuevo("UIScale", { Scale = 2.5, Parent = l })
	tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duracion or 0.8, function()
		tween(l, 0.25, { TextTransparency = 1 })
		tween(s, 0.25, { Scale = 0.6 })
		task.wait(0.3)
		l:Destroy()
	end)
end

function UI.Resultado(gane, empate, recompensa, ganador)
	local color = empate and Color3.fromRGB(200, 200, 220) or (gane and ORO or Color3.fromRGB(200, 50, 50))
	local fondo = nuevo("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = gane and Color3.fromRGB(40, 30, 0) or Color3.fromRGB(30, 0, 0), BackgroundTransparency = 1, ZIndex = 16, Parent = guiTop })
	tween(fondo, 1, { BackgroundTransparency = 0.45 })
	local titulo = texto({ Text = empate and "EMPATE" or (gane and "VICTORIA" or "DERROTA"), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromScale(0.8, 0.22), TextColor3 = color, ZIndex = 17, Parent = fondo })
	nuevo("UIStroke", { Thickness = 6, Color = Color3.new(0, 0, 0), Parent = titulo })
	local s = nuevo("UIScale", { Scale = 4, Parent = titulo })
	tween(s, 0.6, { Scale = 1 }, Enum.EasingStyle.Bounce)
	local sub = texto({
		Text = (ganador and not gane and (ganador .. " gana el duelo  ·  ") or "") .. "+" .. recompensa .. " FUERZA",
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.fromScale(0.6, 0.06), Font = FUENTE2, TextTransparency = 1, ZIndex = 17, Parent = fondo,
	})
	task.delay(0.6, function()
		tween(sub, 0.5, { TextTransparency = 0 })
	end)
	return function()
		tween(fondo, 0.5, { BackgroundTransparency = 1 })
		tween(titulo, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		tween(sub, 0.5, { TextTransparency = 1 })
		task.delay(0.55, function()
			fondo:Destroy()
		end)
	end
end

function UI.MostrarPrincipal(visible)
	panelFuerza.Visible = visible
	botonClub.Visible = visible
	if not visible then
		panelClub.Visible = false
		aviso.Visible = false
	end
	hotbar.Visible = visible
end

return UI
