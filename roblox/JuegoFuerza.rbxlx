    </Properties>
    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Main — punto de entrada del servidor.
	Módulos hijos: Datos, Red, Entrenamiento, Habilidades, Clubs, Duelo.
	El cliente SOLO pide acciones por Remotes; todo se valida aquí.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Datos = require(script.Datos)
local Red = require(script.Red)
local Entrenamiento = require(script.Entrenamiento)
local Habilidades = require(script.Habilidades)
local Clubs = require(script.Clubs)
local Duelo = require(script.Duelo)

Entrenamiento.Multiplicador = Clubs.MultiplicadorEntreno

Datos.Iniciar()
Entrenamiento.Iniciar()
Habilidades.Iniciar()
Clubs.Iniciar()
Duelo.Iniciar()

Red.Remotes.ObtenerEstado.OnServerInvoke = function(player)
	return Clubs.Estado(player, Duelo)
end

-- Comandos de prueba (solo en Studio) ---------------------------------------
if Config.Debug.ComandosEnStudio and RunService:IsStudio() then
	local function alChatear(player, mensaje)
		local cmd, arg = mensaje:match("^/(%a+)%s*(%-?[%d%.]*)")
		if not cmd then
			return
		end
		cmd = cmd:lower()
		local n = tonumber(arg)
		local perfil = Datos.Perfiles[player]
		if not perfil then
			return
		end
		if cmd == "fuerza" and n then
			Datos.FijarFuerza(player, n)
			Red.Mensaje(player, "[Debug] Fuerza = " .. n)
		elseif cmd == "dias" and n and perfil.Club then
			-- Adelanta el reloj del club N días (para los dos miembros)
			local desplazamiento = math.floor(n * Config.Mentoria.SegundosPorDia)
			perfil.Club.Inicio -= desplazamiento
			Datos.Sincronizar(player)
			local otro = Clubs.Companero(player)
			if otro then
				Datos.Perfiles[otro].Club.Inicio = perfil.Club.Inicio
				Datos.Sincronizar(otro)
			end
			Red.Mensaje(player, ("[Debug] Club adelantado %s días"):format(arg))
		elseif cmd == "duelo" then
			if not Duelo.Forzar(player) then
				Red.Mensaje(player, "[Debug] Necesitas un compañero de club en el servidor.")
			end
		end
	end
	-- TextChatService: el cliente registra TextChatCommands y nos manda el texto.
	Red.Remotes.ComandoDebug.OnServerEvent:Connect(function(player, mensaje)
		if type(mensaje) == "string" then
			alChatear(player, mensaje)
		end
	end)
	local function conectar(player)
		-- Chat clásico (LegacyChatService)
		player.Chatted:Connect(function(m)
			if game:GetService("TextChatService").ChatVersion == Enum.ChatVersion.LegacyChatService then
				alChatear(player, m)
			end
		end)
	end
	Players.PlayerAdded:Connect(conectar)
	for _, p in ipairs(Players:GetPlayers()) do
		conectar(p)
	end
	print("[Main] Comandos de Studio activos: /fuerza N, /dias N, /duelo")
end

print("[Main] Servidor listo.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Clubs</string>
          <string name="Source"><![CDATA[--[[
	Clubs — clubs de 2 jugadores (mentor + aprendiz).
	 • Invitar / Aceptar / Rechazar / Salir (validado en servidor).
	 • Mentor = el más fuerte en cada momento (se calcula, no se fija).
	 • Bonus de entrenamiento para el aprendiz cerca de su mentor.
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Config)
local Datos = require(script.Parent.Datos)
local Red = require(script.Parent.Red)

local Clubs = {}
local pendientes = {} -- [invitado] = { De = player, Expira = os.clock() }
local ultimaInvitacion = {} -- anti-spam [player] = os.clock()

local VERDE = Color3.fromRGB(110, 255, 140)
local ROJO = Color3.fromRGB(255, 100, 100)

function Clubs.Companero(player)
	local perfil = Datos.Perfiles[player]
	if not perfil or not perfil.Club then
		return nil
	end
	local otro = Players:GetPlayerByUserId(perfil.Club.CompaneroId)
	if otro and Datos.Perfiles[otro] and Datos.Perfiles[otro].Club and Datos.Perfiles[otro].Club.Id == perfil.Club.Id then
		return otro
	end
	return nil
end

function Clubs.DiasEnClub(player)
	local perfil = Datos.Perfiles[player]
	if not perfil or not perfil.Club then
		return 0
	end
	return (os.time() - (perfil.Club.Inicio or os.time())) / Config.Mentoria.SegundosPorDia
end

-- Multiplicador para el aprendiz que entrena cerca de su mentor (más fuerte).
function Clubs.MultiplicadorEntreno(player)
	local otro = Clubs.Companero(player)
	if not otro then
		return 1, nil
	end
	local yo, el = Datos.Perfiles[player], Datos.Perfiles[otro]
	if el.Fuerza <= yo.Fuerza then
		return 1, nil
	end
	local a, b = Red.Raiz(player), Red.Raiz(otro)
	if a and b and (a.Position - b.Position).Magnitude <= Config.Mentoria.DistanciaBonus then
		return Config.Mentoria.BonusAprendiz, otro
	end
	return 1, nil
end

local function fijarClub(player, club)
	local perfil = Datos.Perfiles[player]
	if perfil then
		perfil.Club = club
		Datos.Sincronizar(player)
	end
end

local function invitar(player, objetivoId)
	if type(objetivoId) ~= "number" then
		return
	end
	local objetivo = Players:GetPlayerByUserId(objetivoId)
	local yo = Datos.Perfiles[player]
	if not objetivo or objetivo == player or not yo then
		return
	end
	local el = Datos.Perfiles[objetivo]
	if not el then
		return
	end
	if os.clock() - (ultimaInvitacion[player] or 0) < 3 then
		return
	end
	ultimaInvitacion[player] = os.clock()
	if yo.Club then
		return Red.Mensaje(player, "Ya estás en un club. Sal primero para invitar a otro.", ROJO)
	end
	if el.Club then
		return Red.Mensaje(player, objetivo.DisplayName .. " ya está en un club.", ROJO)
	end
	local p = pendientes[objetivo]
	if p and p.Expira > os.clock() then
		return Red.Mensaje(player, objetivo.DisplayName .. " tiene otra invitación pendiente.", ROJO)
	end
	pendientes[objetivo] = { De = player, Expira = os.clock() + Config.Mentoria.TiempoInvitacion }
	Red.Remotes.ClubInvitacion:FireClient(objetivo, {
		DeNombre = player.DisplayName,
		DeId = player.UserId,
		DeFuerza = yo.Fuerza,
		Tiempo = Config.Mentoria.TiempoInvitacion,
	})
	Red.Mensaje(player, "Invitación enviada a " .. objetivo.DisplayName, VERDE)
end

local function responder(player, aceptar)
	local p = pendientes[player]
	pendientes[player] = nil
	if not p or p.Expira < os.clock() then
		return
	end
	local otro = p.De
	if not otro.Parent then
		return Red.Mensaje(player, "Quien te invitó ya no está.", ROJO)
	end
	if not aceptar then
		return Red.Mensaje(otro, player.DisplayName .. " rechazó tu invitación.", ROJO)
	end
	local a, b = Datos.Perfiles[player], Datos.Perfiles[otro]
	if not a or not b or a.Club or b.Club then
		return Red.Mensaje(player, "No se pudo crear el club.", ROJO)
	end
	local id = HttpService:GenerateGUID(false)
	local inicio = os.time()
	fijarClub(player, { Id = id, CompaneroId = otro.UserId, CompaneroNombre = otro.DisplayName, Inicio = inicio })
	fijarClub(otro, { Id = id, CompaneroId = player.UserId, CompaneroNombre = player.DisplayName, Inicio = inicio })
	for _, j in ipairs({ player, otro }) do
		Red.Notificar(j, "Club", { Texto = "¡Club formado! Entrenad juntos." })
		task.spawn(Datos.Guardar, j)
	end
end

function Clubs.Salir(player)
	local perfil = Datos.Perfiles[player]
	if not perfil or not perfil.Club or player:GetAttribute("EnDuelo") then
		return
	end
	local otro = Clubs.Companero(player)
	fijarClub(player, nil)
	Red.Notificar(player, "Club", { Texto = "Has salido del club." })
	task.spawn(Datos.Guardar, player)
	if otro then
		fijarClub(otro, nil)
		Red.Notificar(otro, "Club", { Texto = player.DisplayName .. " ha dejado el club." })
		task.spawn(Datos.Guardar, otro)
	end
	-- Si el compañero está desconectado, al volver comprobará que el club ya no existe.
end

-- Al entrar: comprobar que el club guardado sigue siendo válido en ambos lados.
local function verificarClub(player, perfil)
	local club = perfil.Club
	if not club then
		return
	end
	local otro = Players:GetPlayerByUserId(club.CompaneroId)
	local valido
	if otro and Datos.Perfiles[otro] then
		local suyo = Datos.Perfiles[otro].Club
		valido = suyo ~= nil and suyo.Id == club.Id
	else
		local ok, guardado = Datos.LeerGuardado(club.CompaneroId)
		if not ok then
			return -- no sabemos: no tocamos nada
		end
		valido = type(guardado) == "table" and type(guardado.Club) == "table" and guardado.Club.Id == club.Id
	end
	if not valido and player.Parent then
		fijarClub(player, nil)
		Red.Notificar(player, "Club", { Texto = "Tu club se disolvió mientras no estabas." })
	end
end

-- Estado para la UI (RemoteFunction ObtenerEstado).
function Clubs.Estado(player, Duelo)
	local perfil = Datos.Perfiles[player]
	if not perfil then
		return nil
	end
	local estado = { Fuerza = perfil.Fuerza }
	if perfil.Club then
		local otro = Clubs.Companero(player)
		local dias = Clubs.DiasEnClub(player)
		estado.Club = {
			CompaneroNombre = perfil.Club.CompaneroNombre,
			CompaneroId = perfil.Club.CompaneroId,
			Dias = dias,
			DiasMinimos = Config.Duelo.DiasMinimos,
			EnServidor = otro ~= nil,
			FuerzaCompanero = otro and Datos.Perfiles[otro].Fuerza or nil,
		}
		if Duelo then
			local ok, motivo = Duelo.Elegible(player)
			estado.Club.DueloDisponible = ok
			estado.Club.MotivoDuelo = motivo
		end
	end
	return estado
end

function Clubs.Iniciar()
	table.insert(Datos.AlCargar, verificarClub)
	Red.Remotes.ClubInvitar.OnServerEvent:Connect(invitar)
	Red.Remotes.ClubResponder.OnServerEvent:Connect(function(player, aceptar)
		responder(player, aceptar == true)
	end)
	Red.Remotes.ClubSalir.OnServerEvent:Connect(Clubs.Salir)
	Players.PlayerRemoving:Connect(function(p)
		pendientes[p] = nil
		ultimaInvitacion[p] = nil
	end)
end

return Clubs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Datos</string>
          <string name="Source"><![CDATA[--[[
	Datos — perfiles de jugador, leaderstats y guardado con DataStoreService.
	Guarda: Fuerza, habilidades desbloqueadas, club (id, compañero, fecha de inicio), duelos ganados.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Config)

local Datos = {}
Datos.Perfiles = {} -- [Player] = perfil
Datos.AlCargar = {} -- callbacks(player, perfil)
Datos.AlCambiarFuerza = {} -- callbacks(player, nueva, anterior)

local store
do
	local ok, resultado = pcall(function()
		return DataStoreService:GetDataStore(Config.Guardado.NombreDataStore)
	end)
	if ok then
		store = resultado
	else
		warn("[Datos] DataStore no disponible (¿Studio sin 'Enable Studio Access to API Services'?):", resultado)
	end
end

local function clave(userId)
	return "Jugador_" .. tostring(userId)
end

local function perfilPorDefecto()
	return {
		Fuerza = 0,
		Habilidades = {},
		Club = nil, -- { Id, CompaneroId, CompaneroNombre, Inicio }
		DuelosGanados = 0,
	}
end

local function conReintentos(fn)
	local ultimoError
	for intento = 1, Config.Guardado.Reintentos do
		local ok, resultado = pcall(fn)
		if ok then
			return true, resultado
		end
		ultimoError = resultado
		task.wait(intento)
	end
	return false, ultimoError
end

-- Lee el registro guardado de cualquier usuario (sirve para comprobar al compañero de club).
function Datos.LeerGuardado(userId)
	if not store then
		return false, nil
	end
	return conReintentos(function()
		return store:GetAsync(clave(userId))
	end)
end

function Datos.Sincronizar(player)
	local perfil = Datos.Perfiles[player]
	if not perfil then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Fuerza") then
		ls.Fuerza.Value = perfil.Fuerza
	end
	player:SetAttribute("Fuerza", perfil.Fuerza)
	local lista = {}
	for id in pairs(perfil.Habilidades) do
		table.insert(lista, id)
	end
	player:SetAttribute("Habilidades", HttpService:JSONEncode(lista))
	local club = perfil.Club
	player:SetAttribute("ClubCompaneroId", club and club.CompaneroId or 0)
	player:SetAttribute("ClubCompaneroNombre", club and club.CompaneroNombre or "")
	player:SetAttribute("ClubInicio", club and club.Inicio or 0)
	player:SetAttribute("DuelosGanados", perfil.DuelosGanados)
end

function Datos.SumarFuerza(player, cantidad)
	local perfil = Datos.Perfiles[player]
	if not perfil or cantidad == 0 then
		return
	end
	local anterior = perfil.Fuerza
	perfil.Fuerza = math.max(0, math.floor(anterior + cantidad))
	Datos.Sincronizar(player)
	for _, cb in ipairs(Datos.AlCambiarFuerza) do
		task.spawn(cb, player, perfil.Fuerza, anterior)
	end
end

function Datos.FijarFuerza(player, valor)
	local perfil = Datos.Perfiles[player]
	if perfil then
		Datos.SumarFuerza(player, valor - perfil.Fuerza)
	end
end

function Datos.Guardar(player)
	local perfil = Datos.Perfiles[player]
	if not perfil or not store then
		return
	end
	if not perfil.Cargado then
		-- La carga falló: NO sobrescribimos para no borrar el progreso real.
		warn("[Datos] No se guarda a", player.Name, "porque su carga falló.")
		return
	end
	local copia = {
		Fuerza = perfil.Fuerza,
		Habilidades = perfil.Habilidades,
		Club = perfil.Club,
		DuelosGanados = perfil.DuelosGanados,
		Version = 1,
	}
	local ok, err = conReintentos(function()
		store:SetAsync(clave(player.UserId), copia, { player.UserId })
	end)
	if not ok then
		warn("[Datos] Error guardando a", player.Name, err)
	end
end

local function crearLeaderstats(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local fuerza = Instance.new("IntValue")
	fuerza.Name = "Fuerza"
	fuerza.Parent = ls
	ls.Parent = player
end

local function alEntrar(player)
	crearLeaderstats(player)
	local perfil = perfilPorDefecto()
	perfil.Cargado = store == nil -- sin DataStore (Studio) jugamos en memoria
	if store then
		local ok, guardado = conReintentos(function()
			return store:GetAsync(clave(player.UserId))
		end)
		if ok then
			perfil.Cargado = true
			if type(guardado) == "table" then
				perfil.Fuerza = tonumber(guardado.Fuerza) or 0
				perfil.Habilidades = type(guardado.Habilidades) == "table" and guardado.Habilidades or {}
				perfil.Club = type(guardado.Club) == "table" and guardado.Club or nil
				perfil.DuelosGanados = tonumber(guardado.DuelosGanados) or 0
			end
		else
			warn("[Datos] No se pudo cargar a", player.Name, guardado)
		end
	end
	if not player.Parent then
		return
	end
	Datos.Perfiles[player] = perfil
	Datos.Sincronizar(player)
	player:SetAttribute("DatosCargados", true)
	for _, cb in ipairs(Datos.AlCargar) do
		task.spawn(cb, player, perfil)
	end
end

function Datos.Iniciar()
	Players.PlayerAdded:Connect(alEntrar)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(alEntrar, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		Datos.Guardar(player)
		Datos.Perfiles[player] = nil
	end)
	-- Autoguardado
	task.spawn(function()
		while true do
			task.wait(Config.Guardado.IntervaloAutoguardado)
			for player in pairs(Datos.Perfiles) do
				task.spawn(Datos.Guardar, player)
			end
		end
	end)
	-- Al cerrar el servidor
	game:BindToClose(function()
		local pendientes = 0
		for player in pairs(Datos.Perfiles) do
			pendientes += 1
			task.spawn(function()
				Datos.Guardar(player)
				pendientes -= 1
			end)
		end
		local limite = os.clock() + 25
		while pendientes > 0 and os.clock() < limite do
			task.wait(0.1)
		end
	end)
end

return Datos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Duelo</string>
          <string name="Source"><![CDATA[--[[
	Duelo — duelo final de espadas entre mentor y aprendiz.
	Requisitos: días mínimos en el club + misma fuerza (margen de Config) + ambos en el servidor.
	Toda la lógica de combate (cooldowns, hitbox, bloqueo, esquiva, vida) se valida aquí.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Config)
local Datos = require(script.Parent.Datos)
local Red = require(script.Parent.Red)
local Clubs = require(script.Parent.Clubs)

local C = Config.Duelo
local Duelo = {}

local duelos = {} -- [player] = duelo
local invitaciones = {} -- [clubId] = { A, B, Aceptados = {}, Expira, Forzado }
local ultimaInvitacion = {} -- [clubId] = os.clock()

local DURACION_INTRO = 3.5

---------------------------------------------------------------- elegibilidad
function Duelo.Elegible(player)
	local perfil = Datos.Perfiles[player]
	if not perfil or not perfil.Club then
		return false, "No estás en un club."
	end
	if duelos[player] then
		return false, "Ya estás en un duelo."
	end
	local dias = Clubs.DiasEnClub(player)
	if dias < C.DiasMinimos then
		return false, ("Faltan %.1f días de mentoría (%d mínimos)."):format(C.DiasMinimos - dias, C.DiasMinimos)
	end
	local otro = Clubs.Companero(player)
	if not otro then
		return false, "Tu compañero tiene que estar en este servidor."
	end
	local a, b = perfil.Fuerza, Datos.Perfiles[otro].Fuerza
	if math.min(a, b) < C.FuerzaMinima then
		return false, ("Los dos necesitáis al menos %d de Fuerza."):format(C.FuerzaMinima)
	end
	if not Config.MismaFuerza(a, b) then
		return false, ("Aún no tenéis la misma fuerza (%d vs %d, margen %d%%)."):format(a, b, C.MargenFuerza * 100)
	end
	if duelos[otro] then
		return false, "Tu compañero está ocupado."
	end
	return true, nil, otro
end

---------------------------------------------------------------- invitaciones
local function enviarInvitacion(a, b, forzado)
	local club = Datos.Perfiles[a].Club
	if not club then
		return
	end
	local inv = invitaciones[club.Id]
	if inv and inv.Expira > os.clock() then
		return
	end
	invitaciones[club.Id] = { A = a, B = b, Aceptados = {}, Expira = os.clock() + C.TiempoInvitacion, Forzado = forzado }
	ultimaInvitacion[club.Id] = os.clock()
	for _, p in ipairs({ a, b }) do
		local rival = p == a and b or a
		Red.Remotes.DueloInvitacion:FireClient(p, { Rival = rival.DisplayName, Tiempo = C.TiempoInvitacion })
	end
end

function Duelo.Forzar(player)
	local otro = Clubs.Companero(player)
	if otro and not duelos[player] and not duelos[otro] then
		local club = Datos.Perfiles[player].Club
		invitaciones[club.Id] = nil
		enviarInvitacion(player, otro, true)
		return true
	end
	return false
end

local function invitacionDe(player)
	local perfil = Datos.Perfiles[player]
	local inv = perfil and perfil.Club and invitaciones[perfil.Club.Id]
	if inv and inv.Expira > os.clock() and (inv.A == player or inv.B == player) then
		return inv, perfil.Club.Id
	end
	return nil
end

---------------------------------------------------------------- utilidades
local function rivalDe(d, p)
	return p == d.A and d.B or d.A
end

local function fijarMovimiento(d, p, velocidad, salto)
	local _, humanoid = Red.Raiz(p)
	if humanoid then
		humanoid.WalkSpeed = velocidad or d.Original[p].WalkSpeed
		humanoid.JumpPower = salto or d.Original[p].JumpPower
		humanoid.JumpHeight = salto and 0 or d.Original[p].JumpHeight
	end
end

local function darEspada(d, p)
	local plantilla = ServerStorage:FindFirstChild("Espadas") and ServerStorage.Espadas:FindFirstChildWhichIsA("Tool")
	local _, humanoid = Red.Raiz(p)
	if not plantilla or not humanoid then
		warn("[Duelo] Falta ServerStorage/Espadas/<Tool>")
		return
	end
	local espada = plantilla:Clone()
	espada.Name = "EspadaDuelo"
	local handle = espada:FindFirstChild("Handle")
	for _, parte in ipairs(espada:GetDescendants()) do
		if parte:IsA("BasePart") then
			parte.Anchored = false
			parte.CanCollide = false
			parte.Massless = true
			if parte ~= handle then
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = handle, parte
				w.Parent = parte
			end
		end
	end
	espada.Grip = CFrame.new(C.GripPos[1], C.GripPos[2], C.GripPos[3])
		* CFrame.Angles(math.rad(C.GripRot[1]), math.rad(C.GripRot[2]), math.rad(C.GripRot[3]))
	espada.Parent = p.Backpack
	humanoid:EquipTool(espada)
	-- No se puede guardar la espada durante el duelo
	espada.Unequipped:Connect(function()
		if duelos[p] == d and not d.Terminado then
			task.defer(function()
				local _, h = Red.Raiz(p)
				if h and espada.Parent == p.Backpack then
					h:EquipTool(espada)
				end
			end)
		end
	end)
	d.Espadas[p] = espada
end

local function limpiar(d, p)
	if d.Espadas[p] then
		d.Espadas[p]:Destroy()
	end
	for _, nombre in ipairs({ "EnDuelo", "DueloRival", "DueloVida", "DueloVidaMax" }) do
		p:SetAttribute(nombre, nil)
	end
	if p.Character and p.Character == d.Personajes[p] then
		fijarMovimiento(d, p)
		Red.DetenerAnim(p.Character)
		p.Character:PivotTo(d.Retorno[p])
	end
	Red.Remotes.DueloEstado:FireClient(p, { Fase = "Salir" })
end

---------------------------------------------------------------- final
local function terminar(d, ganador)
	if d.Terminado then
		return
	end
	d.Terminado = true
	d.Fase = "Fin"
	for _, con in ipairs(d.Conexiones) do
		con:Disconnect()
	end
	local presentes = {}
	for _, p in ipairs({ d.A, d.B }) do
		if p.Parent then
			table.insert(presentes, p)
		end
	end
	for _, p in ipairs(presentes) do
		local gane = p == ganador
		local recompensa = ganador == nil and C.RecompensaPerdedor or (gane and C.RecompensaGanador or C.RecompensaPerdedor)
		fijarMovimiento(d, p, 0, 0)
		Red.Remotes.DueloEstado:FireClient(p, {
			Fase = "Fin",
			Ganador = ganador and ganador.DisplayName or nil,
			Gane = gane,
			Empate = ganador == nil,
			Recompensa = recompensa,
			GanadorJugador = ganador,
		})
		if p.Character then
			Red.AnimTodos(p.Character, gane and "Victoria" or "Derrota", { Mantener = true })
		end
		Datos.SumarFuerza(p, recompensa)
		if gane then
			Datos.Perfiles[p].DuelosGanados += 1
			Datos.Sincronizar(p)
		end
	end
	task.delay(C.RetornoTras, function()
		for _, p in ipairs(presentes) do
			if p.Parent then
				limpiar(d, p)
				task.spawn(Datos.Guardar, p)
			end
		end
		if duelos[d.A] == d then
			duelos[d.A] = nil
		end
		if duelos[d.B] == d then
			duelos[d.B] = nil
		end
	end)
end

---------------------------------------------------------------- inicio
local function iniciar(a, b)
	local arena = Workspace:FindFirstChild("Arena")
	if not arena or not arena:FindFirstChild("PuntoA") or not arena:FindFirstChild("PuntoB") then
		warn("[Duelo] Falta Workspace/Arena con PuntoA y PuntoB")
		return
	end
	if not Red.Raiz(a) or not Red.Raiz(b) then
		return
	end
	local d = {
		A = a, B = b, Fase = "Intro", Terminado = false,
		Vida = { [a] = C.Vida, [b] = C.Vida },
		Estado = {}, Retorno = {}, Original = {}, Espadas = {}, Personajes = {}, Conexiones = {},
	}
	for _, p in ipairs({ a, b }) do
		local raiz, humanoid = Red.Raiz(p)
		duelos[p] = d
		d.Estado[p] = {
			Bloqueando = false, Invulnerable = 0, Aturdido = 0,
			CdLigero = 0, CdPesado = 0, CdEsquiva = 0, ComboIdx = 0, UltimoLigero = 0,
		}
		d.Retorno[p] = raiz.CFrame
		d.Personajes[p] = p.Character
		d.Original[p] = { WalkSpeed = humanoid.WalkSpeed, JumpPower = humanoid.JumpPower, JumpHeight = humanoid.JumpHeight }
		local punto = p == a and arena.PuntoA or arena.PuntoB
		p.Character:PivotTo(punto.CFrame + Vector3.new(0, 2, 0))
		fijarMovimiento(d, p, 0, 0)
		p:SetAttribute("EnDuelo", true)
		p:SetAttribute("DueloRival", rivalDe(d, p).DisplayName)
		p:SetAttribute("DueloVidaMax", C.Vida)
		p:SetAttribute("DueloVida", C.Vida)
		table.insert(d.Conexiones, humanoid.Died:Connect(function()
			terminar(d, rivalDe(d, p))
		end))
	end
	for _, p in ipairs({ a, b }) do
		Red.Remotes.DueloEstado:FireClient(p, {
			Fase = "Intro",
			Rival = rivalDe(d, p),
			Centro = arena:FindFirstChild("Centro") and arena.Centro.Position or arena.PuntoA.Position,
			Duracion = DURACION_INTRO,
		})
	end
	task.wait(1.6)
	for _, p in ipairs({ a, b }) do
		if not d.Terminado then
			darEspada(d, p)
			if p.Character then
				Red.AnimTodos(p.Character, "Espada_Desenvainar")
			end
		end
	end
	task.wait(DURACION_INTRO - 1.6)
	if d.Terminado then
		return
	end
	d.Fase = "Cuenta"
	for _, p in ipairs({ a, b }) do
		Red.Remotes.DueloEstado:FireClient(p, { Fase = "Cuenta", Segundos = C.CuentaAtras })
	end
	task.wait(C.CuentaAtras)
	if d.Terminado then
		return
	end
	d.Fase = "Lucha"
	for _, p in ipairs({ a, b }) do
		fijarMovimiento(d, p)
		Red.Remotes.DueloEstado:FireClient(p, { Fase = "Lucha" })
	end
	task.delay(C.DuracionMaxima, function()
		if not d.Terminado then
			local va, vb = d.Vida[a], d.Vida[b]
			if va == vb then
				terminar(d, nil)
			else
				terminar(d, va > vb and a or b)
			end
		end
	end)
end

---------------------------------------------------------------- combate
local function golpear(d, atacante, dano, pesado)
	if d.Terminado or d.Fase ~= "Lucha" then
		return
	end
	local ahora = os.clock()
	if d.Estado[atacante].Aturdido > ahora then
		return
	end
	local rival = rivalDe(d, atacante)
	local ra, rr = Red.Raiz(atacante), Red.Raiz(rival)
	if not ra or not rr then
		return
	end
	Red.Efecto({ Tipo = "Tajo", Origen = atacante, Pesado = pesado })
	-- Hitbox validada en servidor: caja delante del atacante
	local rel = ra.CFrame:PointToObjectSpace(rr.Position)
	local profundidad = -rel.Z
	if profundidad < -1 or profundidad > C.AlcanceEspada + 1.5 or math.abs(rel.X) > C.AnchoHitbox / 2 or math.abs(rel.Y) > 6 then
		return
	end
	local se = d.Estado[rival]
	if se.Invulnerable > ahora then
		Red.Efecto({ Tipo = "Texto", Pos = rr.Position + Vector3.new(0, 3, 0), Texto = "¡ESQUIVADO!" })
		return
	end
	local deFrente = rr.CFrame.LookVector:Dot((ra.Position - rr.Position).Unit) > 0.2
	local bloqueado = se.Bloqueando and deFrente
	if bloqueado and pesado and C.Pesado.RompeBloqueo then
		bloqueado = false
		se.Bloqueando = false
		se.Aturdido = ahora + C.Aturdimiento
		fijarMovimiento(d, rival)
		Red.Efecto({ Tipo = "Texto", Pos = rr.Position + Vector3.new(0, 3, 0), Texto = "¡GUARDIA ROTA!" })
	end
	if bloqueado then
		dano = dano * (1 - C.BloqueoReduccion)
	end
	d.Vida[rival] = math.max(0, d.Vida[rival] - math.floor(dano))
	rival:SetAttribute("DueloVida", d.Vida[rival])
	Red.Efecto({
		Tipo = "GolpeEspada",
		Pos = rr.Position,
		Dir = (rr.Position - ra.Position).Unit,
		Bloqueado = bloqueado,
		Pesado = pesado,
		Fuerza = pesado and 0.9 or 0.35,
		Dano = math.floor(dano),
	})
	if not bloqueado then
		Red.AnimTodos(rival.Character, "Espada_Impacto")
		local dir = (rr.Position - ra.Position) * Vector3.new(1, 0, 1)
		dir = dir.Magnitude > 0 and dir.Unit or ra.CFrame.LookVector
		Red.Empujar(rival, dir * (pesado and 65 or 28) + Vector3.new(0, pesado and 25 or 8, 0))
	end
	if d.Vida[rival] <= 0 then
		terminar(d, atacante)
	end
end

local function accion(player, tipo)
	local d = duelos[player]
	if not d or d.Fase ~= "Lucha" or d.Terminado or type(tipo) ~= "string" then
		return
	end
	local st = d.Estado[player]
	local ahora = os.clock()
	if st.Aturdido > ahora and tipo ~= "BloqueoOff" then
		return
	end
	if tipo == "Ligero" then
		if st.Bloqueando or ahora < st.CdLigero then
			return
		end
		st.CdLigero = ahora + C.ComboCooldown
		st.ComboIdx = (ahora - st.UltimoLigero <= C.ComboVentana) and (st.ComboIdx % #C.Combo + 1) or 1
		st.UltimoLigero = ahora
		Red.AnimOtros(player, "Espada_Combo" .. st.ComboIdx)
		task.delay(C.ComboRetraso, golpear, d, player, C.Combo[st.ComboIdx], false)
	elseif tipo == "Pesado" then
		if st.Bloqueando or ahora < st.CdPesado then
			return
		end
		st.CdPesado = ahora + C.Pesado.Cooldown
		st.CdLigero = ahora + C.Pesado.Retraso
		Red.AnimOtros(player, "Espada_Pesado")
		Red.Efecto({ Tipo = "CargaPesado", Origen = player })
		task.delay(C.Pesado.Retraso, golpear, d, player, C.Pesado.Dano, true)
	elseif tipo == "BloqueoOn" then
		st.Bloqueando = true
		fijarMovimiento(d, player, C.BloqueoVelocidad)
		Red.AnimOtros(player, "Espada_Bloqueo")
	elseif tipo == "BloqueoOff" then
		if st.Bloqueando then
			st.Bloqueando = false
			fijarMovimiento(d, player)
		end
		Red.AnimOtros(player, "Espada_Bloqueo", { Detener = true })
	elseif tipo == "Esquiva" then
		if ahora < st.CdEsquiva then
			return
		end
		st.CdEsquiva = ahora + C.Esquiva.Cooldown
		st.Invulnerable = ahora + C.Esquiva.Invulnerable
		Red.AnimOtros(player, "Espada_Esquiva")
	end
end

---------------------------------------------------------------- arranque
function Duelo.EnDuelo(player)
	return duelos[player] ~= nil
end

function Duelo.Iniciar()
	Red.Remotes.DueloAccion.OnServerEvent:Connect(accion)

	Red.Remotes.DueloResponder.OnServerEvent:Connect(function(player, aceptar)
		local inv, clubId = invitacionDe(player)
		if not inv then
			return
		end
		local otro = inv.A == player and inv.B or inv.A
		if aceptar ~= true then
			invitaciones[clubId] = nil
			Red.Mensaje(player, "Has rechazado el duelo.")
			if otro.Parent then
				Red.Mensaje(otro, player.DisplayName .. " ha rechazado el duelo.", Color3.fromRGB(255, 120, 120))
			end
			return
		end
		inv.Aceptados[player] = true
		if inv.Aceptados[otro] then
			invitaciones[clubId] = nil
			if otro.Parent and (inv.Forzado or Duelo.Elegible(player)) then
				task.spawn(iniciar, inv.A, inv.B)
			else
				Red.Mensaje(player, "El duelo ya no está disponible.")
			end
		else
			Red.Mensaje(player, "Esperando a que " .. otro.DisplayName .. " acepte...")
		end
	end)

	-- Petición manual desde el panel del club
	local ultimaPeticion = {}
	Red.Remotes.DueloSolicitar.OnServerEvent:Connect(function(player)
		if os.clock() - (ultimaPeticion[player] or 0) < 5 then
			return
		end
		ultimaPeticion[player] = os.clock()
		local ok, motivo, otro = Duelo.Elegible(player)
		if ok then
			enviarInvitacion(player, otro)
		else
			Red.Mensaje(player, motivo, Color3.fromRGB(255, 200, 90))
		end
	end)

	-- Abandono = derrota
	Players.PlayerRemoving:Connect(function(p)
		local d = duelos[p]
		if d then
			terminar(d, rivalDe(d, p))
		end
		ultimaPeticion[p] = nil
	end)

	-- Invitaciones automáticas cuando se cumplen las condiciones
	task.spawn(function()
		while true do
			task.wait(5)
			local vistos = {}
			for p, perfil in pairs(Datos.Perfiles) do
				local club = perfil.Club
				if club and not vistos[club.Id] then
					vistos[club.Id] = true
					local ok, _, otro = Duelo.Elegible(p)
					if ok and os.clock() - (ultimaInvitacion[club.Id] or -math.huge) >= C.CooldownInvitacion then
						enviarInvitacion(p, otro)
					end
				end
			end
		end
	end)
end

return Duelo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Entrenamiento</string>
          <string name="Source"><![CDATA[--[[
	Entrenamiento — equipos de Workspace/Entrenamiento (ProximityPrompt) y muñecos de práctica.
	Todo se valida aquí: cooldown, distancia, fuerza requerida y bonus de mentor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Config)
local Datos = require(script.Parent.Datos)
local Red = require(script.Parent.Red)

local Entrenamiento = {}
Entrenamiento.Multiplicador = function(_player)
	return 1, nil
end -- lo sustituye Clubs (bonus de mentor)

local ultimoEntreno = {} -- [player] = os.clock()

local function alActivar(player, equipo, prompt)
	local clave = equipo:GetAttribute("Clave")
	local def = Config.Entrenamiento.Equipos[clave]
	local perfil = Datos.Perfiles[player]
	if not def or not perfil or player:GetAttribute("EnDuelo") then
		return
	end
	local raiz = Red.Raiz(player)
	if not raiz then
		return
	end
	local ahora = os.clock()
	if ahora - (ultimoEntreno[player] or 0) < Config.Entrenamiento.Cooldown then
		return
	end
	local parte = prompt.Parent
	if parte:IsA("BasePart") and (parte.Position - raiz.Position).Magnitude > Config.Entrenamiento.DistanciaMaxima then
		return
	end
	if perfil.Fuerza < def.Requisito then
		Red.Mensaje(player, ("Necesitas %d de Fuerza para este equipo"):format(def.Requisito), Color3.fromRGB(255, 90, 90))
		return
	end
	ultimoEntreno[player] = ahora
	local mult, mentor = Entrenamiento.Multiplicador(player)
	local ganancia = math.floor(def.Fuerza * mult)
	Red.AnimTodos(player.Character, def.Anim)
	Datos.SumarFuerza(player, ganancia)
	Red.Notificar(player, "Ganancia", {
		Cantidad = ganancia,
		Bonus = mult > 1 and mult or nil,
		Mentor = mentor and mentor.Name or nil,
		Cooldown = Config.Entrenamiento.Cooldown,
	})
end

---------------------------------------------------------------- Muñecos
local munecos = {}

local function partePrincipal(muneco)
	return muneco:FindFirstChild("Cuerpo") or muneco.PrimaryPart or muneco:FindFirstChildWhichIsA("BasePart")
end

function Entrenamiento.ObtenerMunecos()
	return munecos
end

function Entrenamiento.PosicionMuneco(muneco)
	local p = partePrincipal(muneco)
	return p and p.Position
end

local function fijarVisible(muneco, visible)
	for _, d in ipairs(muneco:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = visible and 0 or 0.85
			d.CanCollide = visible
		end
	end
end

-- Devuelve true si el golpe dejó KO al muñeco.
function Entrenamiento.DanarMuneco(muneco, dano, atacante)
	local vida = muneco:GetAttribute("Vida") or 0
	if vida <= 0 then
		return false
	end
	vida = math.max(0, vida - dano)
	muneco:SetAttribute("Vida", vida)
	if vida <= 0 then
		fijarVisible(muneco, false)
		if atacante then
			local premio = Config.Entrenamiento.Munecos.FuerzaPorKO
			Datos.SumarFuerza(atacante, premio)
			Red.Notificar(atacante, "Ganancia", { Cantidad = premio, Texto = "¡KO!" })
		end
		task.delay(Config.Entrenamiento.Munecos.Reaparicion, function()
			muneco:SetAttribute("Vida", muneco:GetAttribute("VidaMax"))
			fijarVisible(muneco, true)
		end)
		return true
	end
	return false
end

function Entrenamiento.Iniciar()
	local zona = Workspace:WaitForChild("Entrenamiento")
	for _, d in ipairs(zona:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local equipo = d.Parent
			while equipo and equipo ~= zona and not equipo:GetAttribute("Clave") do
				equipo = equipo.Parent
			end
			if equipo and equipo ~= zona then
				local def = Config.Entrenamiento.Equipos[equipo:GetAttribute("Clave")]
				if def then
					equipo:SetAttribute("Requisito", def.Requisito)
					equipo:SetAttribute("Ganancia", def.Fuerza)
				end
				d.Triggered:Connect(function(player)
					alActivar(player, equipo, d)
				end)
			end
		end
	end
	local carpeta = zona:FindFirstChild("Munecos")
	if carpeta then
		for _, m in ipairs(carpeta:GetChildren()) do
			if m:IsA("Model") then
				m:SetAttribute("VidaMax", m:GetAttribute("VidaMax") or 500)
				m:SetAttribute("Vida", m:GetAttribute("VidaMax"))
				table.insert(munecos, m)
			end
		end
	end
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		ultimoEntreno[p] = nil
	end)
end

return Entrenamiento
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Habilidades</string>
          <string name="Source"><![CDATA[--[[
	Habilidades — desbloqueo automático por fuerza y ejecución validada en servidor
	(desbloqueo, cooldown, alcance y daño). Fuera del duelo solo dañan a los muñecos.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Config)
local Datos = require(script.Parent.Datos)
local Red = require(script.Parent.Red)
local Entrenamiento = require(script.Parent.Entrenamiento)

local Habilidades = {}
local cooldowns = {} -- [player] = { [id] = os.clock() de fin }

local function comprobarDesbloqueos(player, avisar)
	local perfil = Datos.Perfiles[player]
	if not perfil then
		return
	end
	local nuevas = {}
	for _, h in ipairs(Config.Habilidades) do
		if perfil.Fuerza >= h.Fuerza and not perfil.Habilidades[h.Id] then
			perfil.Habilidades[h.Id] = true
			table.insert(nuevas, h)
		end
	end
	if #nuevas > 0 then
		Datos.Sincronizar(player)
		if avisar then
			for i, h in ipairs(nuevas) do
				task.delay((i - 1) * 3.2, function()
					if player.Parent then
						Red.Notificar(player, "Desbloqueo", { Id = h.Id, Nombre = h.Nombre, Tecla = h.Tecla })
					end
				end)
			end
		end
	end
end

-- Objetivos en un radio/caja. filtro(pos) -> bool
local function objetivosEn(atacante, filtro)
	local lista = {}
	for _, m in ipairs(Entrenamiento.ObtenerMunecos()) do
		local pos = Entrenamiento.PosicionMuneco(m)
		if pos and (m:GetAttribute("Vida") or 0) > 0 and filtro(pos) then
			table.insert(lista, { Muneco = m, Pos = pos })
		end
	end
	return lista
end

local function enCaja(raizCF, alcance, ancho)
	return function(pos)
		local rel = raizCF:PointToObjectSpace(pos)
		return -rel.Z >= -1.5 and -rel.Z <= alcance + 1.5 and math.abs(rel.X) <= ancho / 2 and math.abs(rel.Y) <= 8
	end
end

local function enRadio(centro, radio)
	return function(pos)
		return (pos - centro).Magnitude <= radio + 2
	end
end

local function aplicar(player, h, lista, origen)
	for _, o in ipairs(lista) do
		Entrenamiento.DanarMuneco(o.Muneco, h.Dano, player)
		Red.Efecto({ Tipo = "Impacto", Pos = o.Pos, Fuerza = h.Temblor, Dir = (o.Pos - origen).Unit })
	end
end

local function ejecutar(player, h)
	local raiz = Red.Raiz(player)
	if not raiz then
		return
	end
	if h.Efecto == "Embestida" then
		-- Muestreamos la trayectoria mientras dura el dash (el cliente mueve su propio personaje).
		local golpeados = {}
		local inicio = os.clock()
		while os.clock() - inicio < h.DuracionDash + 0.1 do
			raiz = Red.Raiz(player)
			if not raiz then
				return
			end
			local lista = objetivosEn(player, enRadio(raiz.Position, h.Alcance))
			local nuevos = {}
			for _, o in ipairs(lista) do
				if not golpeados[o.Muneco] then
					golpeados[o.Muneco] = true
					table.insert(nuevos, o)
				end
			end
			aplicar(player, h, nuevos, raiz.Position)
			task.wait(0.05)
		end
		Red.Efecto({ Tipo = "Embestida", Pos = raiz.Position, Radio = h.Alcance, Origen = player, Fuerza = h.Temblor })
		return
	end
	local cf = raiz.CFrame
	local pos = raiz.Position
	local filtro
	if h.Efecto == "Golpe" then
		filtro = enCaja(cf, h.Alcance, 7)
	else
		filtro = enRadio(pos, h.Alcance)
	end
	-- Posición del suelo para efectos de impacto
	local suelo = pos - Vector3.new(0, 3, 0)
	Red.Efecto({
		Tipo = h.Efecto,
		Pos = h.Efecto == "Golpe" and (cf * CFrame.new(0, 0, -4)).Position or suelo,
		Dir = cf.LookVector,
		Radio = h.Alcance,
		Fuerza = h.Temblor,
		Origen = player,
	})
	aplicar(player, h, objetivosEn(player, filtro), pos)
end

local function alUsar(player, id)
	if type(id) ~= "string" then
		return
	end
	local h = Config.ObtenerHabilidad(id)
	local perfil = Datos.Perfiles[player]
	if not h or not perfil or not perfil.Habilidades[id] then
		return
	end
	if player:GetAttribute("EnDuelo") and not Config.HabilidadesEnDuelo then
		return
	end
	if not Red.Raiz(player) then
		return
	end
	cooldowns[player] = cooldowns[player] or {}
	local ahora = os.clock()
	-- pequeña tolerancia por latencia
	if (cooldowns[player][id] or 0) - 0.15 > ahora then
		return
	end
	cooldowns[player][id] = ahora + h.Cooldown
	Red.AnimOtros(player, h.Anim)
	Red.Efecto({ Tipo = "Carga", Origen = player, Id = id })
	task.delay(h.Retraso, ejecutar, player, h)
end

function Habilidades.Iniciar()
	table.insert(Datos.AlCargar, function(player)
		comprobarDesbloqueos(player, false)
	end)
	table.insert(Datos.AlCambiarFuerza, function(player)
		comprobarDesbloqueos(player, true)
	end)
	Red.Remotes.UsarHabilidad.OnServerEvent:Connect(alUsar)
	Players.PlayerRemoving:Connect(function(p)
		cooldowns[p] = nil
	end)
end

return Habilidades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Red</string>
          <string name="Source"><![CDATA[--[[
	Red — atajos para los RemoteEvents de ReplicatedStorage/Remotes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Red = {}
Red.Remotes = ReplicatedStorage:WaitForChild("Remotes")

-- Notificación de interfaz: Tipo = "Ganancia" | "Mensaje" | "Desbloqueo" | ...
function Red.Notificar(player, tipo, datos)
	datos = datos or {}
	datos.Tipo = tipo
	Red.Remotes.Notificar:FireClient(player, datos)
end

function Red.Mensaje(player, texto, color)
	Red.Notificar(player, "Mensaje", { Texto = texto, Color = color })
end

-- Animación iniciada por el servidor: la ven todos (incluido el dueño).
function Red.AnimTodos(personaje, nombre, opciones)
	Red.Remotes.Anim:FireAllClients(personaje, nombre, opciones or {})
end

-- Animación que el propio cliente ya reprodujo (predicción): solo al resto.
function Red.AnimOtros(player, nombre, opciones)
	local personaje = player.Character
	for _, otro in ipairs(Players:GetPlayers()) do
		if otro ~= player then
			Red.Remotes.Anim:FireClient(otro, personaje, nombre, opciones or {})
		end
	end
end

function Red.DetenerAnim(personaje)
	Red.Remotes.Anim:FireAllClients(personaje, nil, { Detener = true })
end

function Red.Efecto(datos)
	Red.Remotes.Efecto:FireAllClients(datos)
end

-- Empuje: el cliente dueño del personaje aplica la física (tiene la propiedad de red).
function Red.Empujar(player, velocidad)
	Red.Remotes.Empuje:FireClient(player, velocidad)
end

function Red.Raiz(player)
	local personaje = player and player.Character
	local humanoid = personaje and personaje:FindFirstChildOfClass("Humanoid")
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	if humanoid and raiz and humanoid.Health > 0 then
		return raiz, humanoid
	end
	return nil
end

return Red
]]></string>
        </Properties>
      </Item>
    </Item>
